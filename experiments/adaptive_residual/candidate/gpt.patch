diff --git a/src/diff_gpt/domain/model/residual_gain.py b/src/diff_gpt/domain/model/residual_gain.py
new file mode 100644
index 0000000..4aa1edf
--- /dev/null
+++ b/src/diff_gpt/domain/model/residual_gain.py
@@ -0,0 +1,34 @@
+"""
+Conditional residual amplitude after output RMS; transformer lab task158.
+
+The known-solution context_gains benchmark extends the Lean declaration
+Transformer.Residual.gain_derivative_ratio to input-dependent amplitudes.
+A zero-initialized, bias-free row gives initial gain one without consuming
+random draws. This gate is separate from the parameter-free RMS operation.
+Its range is (0, 2); it is not a universal gradient or generalization bound.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING
+
+from torch import nn
+
+if TYPE_CHECKING:
+    from torch import Tensor
+
+
+class ResidualGain(nn.Linear):
+    """A bounded conditional branch gain, initialized to preserve the model."""
+
+    def __init__(self, width: int) -> None:
+        """Read the branch's already normalized input without a bias."""
+        super().__init__(width, 1, bias=False)
+
+    def reset_parameters(self) -> None:
+        """Preserve common-model initialization and its random-generator state."""
+        nn.init.zeros_(self.weight)
+
+    def forward(self, value: Tensor) -> Tensor:
+        """Return one gain per token, initially exactly one."""
+        return 2 * super().forward(value).sigmoid()

+// The bounded operations follow Transformer.Phasor.PowerAddresses. Prefix
+// substitutions still use the running context after these base keys are copied.
+fn addresses(left: &TokenPowers, right: &TokenPowers, p: usize) -> [u32; TABLES] {
+    let (a, b) = (left.powers[0], right.powers[0]);
     let mut result = [0; TABLES];
     let mut keys = result.iter_mut().enumerate();
     let mut put = |value| {
         let (table, dest) = keys.next().unwrap();
         *dest = (table * p + value) as u32;
     };
-    for value in [b, (a + p - b) % p, a.abs_diff(b), a * factor_b % p] {

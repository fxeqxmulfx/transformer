# ── Lean / Lake build artifacts ──────────────────────────────────────────
/.lake/
build/
*.olean
*.ilean
*.trace
*.hash

# ── Papers ───────────────────────────────────────────────────────────────
# arXiv sources of the papers the tree cites, each in papers/arXiv-<id>/ at
# the version cited; `./make.py papers` fetches the missing ones.
/papers/

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# ── Editors / OS ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
*.swp
*~

# ── discrtree ────────────────────────────────────────────────────────────
# The tool's own state: the config, the index, the JSONL dumps and the
# fetched corpora.  Local to the machine, and reproducible with
# `dt init && dt fetch && dt dump && dt index`.
/.discrtree/
/discrtree.toml
/.claude/skills/discrtree/

# ── Experiments ──────────────────────────────────────────────────────────
/experiments/*/runs/
/experiments/archive/synthetic_trainers/runs/

new file mode 100644
index 00000000..1027e0f3
--- /dev/null
+++ b/experiments/phasor_value_transport/src/relation_rows.rs
@@ -0,0 +1,49 @@
+//! Sparse source rows for causal triples, as in Phasor.readRelationRows_fold.
+//! Relation labels stay sorted within each row across writes and overwrites.
+pub struct Edges {
+    rows: Vec<Vec<(u32, u32)>>,
+    written: Vec<u32>,
+}
+
+impl Edges {
+    pub fn new(vocab: usize) -> Self {
+        Self {
+            rows: vec![Vec::new(); vocab],
+            written: Vec::new(),
+        }
+    }
+
+    pub fn clear(&mut self) {
+        for source in self.written.drain(..) {
+            self.rows[source as usize] = Vec::new();
+        }
+    }
+
+    pub fn outgoing(&self, source: u32) -> &[(u32, u32)] {
+        &self.rows[source as usize]
+    }
+
+    pub fn get(&self, &(source, relation): &(u32, u32)) -> Option<&u32> {
+        let row = self.outgoing(source);
+        row.binary_search_by_key(&relation, |&(h, _)| h)
+            .ok()
+            .map(|at| &row[at].1)
+    }
+
+    pub fn contains_key(&self, key: &(u32, u32)) -> bool {
+        self.get(key).is_some()
+    }
+
+    pub fn insert(&mut self, (source, relation): (u32, u32), end: u32) {
+        let row = &mut self.rows[source as usize];
+        match row.binary_search_by_key(&relation, |&(h, _)| h) {
+            Ok(at) => row[at].1 = end,
+            Err(at) => {
+                if row.is_empty() {
+                    self.written.push(source);
+                }
+                row.insert(at, (relation, end));
+            }
+        }
+    }
+}

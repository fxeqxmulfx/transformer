  "descriptions_and_fresh_seeds_verified": true,
  "runtime_source_hashes_verified": 78,
  "program_source": "\"\"\"Independently check step-5 reduction and both complete archived control histories.\"\"\"\n\nimport copy\nimport hashlib\nimport json\nfrom pathlib import Path\nimport runpy\n\n\nROOT = Path('/home/misha/lean_projects/transformer')\nEXPERIMENT = ROOT / 'experiments/mod193_stability'\nARCHIVE = ROOT / 'experiments/archive/synthetic_trainers/runs/adamw_stability_20261002/attention_mod193_fraction25_lr0003_budget300k'\nPOLICY = ROOT / 'experiments/archive/synthetic_trainers/protocols/adamw_stability_20261002/sparsemax-final-review/confirmation_metrics.py'\n\n\ndef sha(path):\n    with path.open('rb') as source:\n        return hashlib.file_digest(source, 'sha256').hexdigest()\n\n\ndef main():\n    result_path = EXPERIMENT / 'confirmation_results.json'\n    result = json.loads(result_path.read_text())\n    summarize = runpy.run_path(str(POLICY))['summarize']\n    assert sha(POLICY) == result['policy_sha256']\n    for field in ('program', 'collector', 'policy'):\n        assert hashlib.sha256(result[field + '_source'].encode()).hexdigest() == result[field + '_sha256']\n    assert sha(EXPERIMENT / 'experiment.py') == result['experiment_source_sha256']\n    assert sha(EXPERIMENT / 'preparation.json') == result['preparation_sha256']\n    code = result['runtime_code_sha256']\n    assert len(code) == 78\n    assert all(sha(ROOT / 'python/src/lab' / path) == digest for path, digest in code.items())\n    assert result['conditional_repeat']['triggered'] and result['conditional_repeat']['confirmed']\n    comparisons = {}\n    checks = {}\n    for label, run in result['runs'].items():\n        history_path = EXPERIMENT / 'runs' / label / 'history.jsonl'\n        history = [json.loads(line) for line in history_path.read_text().splitlines()]\n        assert len(history) == 1201\n        assert summarize(history) == run['canonical_metrics'], label\n        assert run['stop'] == {'step': 300000, 'reason': 'budget'}\n        assert run['attention_observations'] == 3601\n        assert run['neighbor_probes'] == 2400\n        assert run['gradient_updates_verified'] == 300000\n        assert sha(history_path) == run['source'][f'runs/{label}/history.jsonl']\n        heads = [head for layer in run['final_heads'].values()\n                 for head in layer['actual']['nontrivial_rows']]\n        assert len(heads) == 8\n        zero_heads = sum(head['exact_zero_pair_share'] > 0 for head in heads)\n        assert zero_heads == (0 if label == 'base' else 8)\n        checks[label] = {'canonical_observations': len(history),\n                         'canonical_metrics': run['canonical_metrics'],\n                         'final_heads_with_visible_zeros': zero_heads,\n                         'total_heads': len(heads),\n                         'history_sha256': sha(history_path)}\n        if label in ('base', 'sparsemax'):\n            archived = ARCHIVE / ('adamw-softmax' if label == 'base' else 'adamw-sparsemax') / 'history.jsonl'\n            old = [json.loads(line) for line in archived.read_text().splitlines()]\n            assert len(old) == len(history)\n            fields = ('step', 'train', 'heldout', 'epochs_seen', 'last_batch_size')\n            differences = [a['step'] for a,b in zip(history, old)\n                           if any(a[field] != b[field] for field in fields)]\n            assert not differences, (label, differences[:10])\n            assert summarize(old) == run['canonical_metrics']\n            comparisons[label] = {'compared_observations': len(history),\n                                  'different_observations': 0, 'fields': fields,\n                                  'archived_history_sha256': sha(archived)}\n    base = result['runs']['base']\n    sparse = result['runs']['sparsemax']\n    attempt = result['runs']['repair-qknorm-one']\n    repeat = result['runs']['repair-qknorm-one-seed1']\n    expected = copy.deepcopy(base['description'])\n    expected['model']['block']['attention']['weights'] = {'type': 'Sparsemax'}\n    assert expected == sparse['description']\n    expected = copy.deepcopy(sparse['description'])\n    expected['model']['block']['attention']['scores']['initial_scale'] = 1.0\n    assert expected == attempt['description']\n    expected = copy.deepcopy(attempt['description'])\n    expected['seeds']['model'] = expected['seeds']['data'] = 1\n    assert expected == repeat['description']\n    assert base['fixed_heldout_rows_sha256'] == sparse['fixed_heldout_rows_sha256'] == attempt['fixed_heldout_rows_sha256']\n    assert repeat['fixed_heldout_rows_sha256'] != attempt['fixed_heldout_rows_sha256']\n    source = Path(__file__).read_text()\n    output = {'scope': 'Independent canonical reduction and archived-history repetition; full raw collection is checked by the embedded collector',\n              'confirmation_results_sha256': sha(result_path), 'controls': comparisons,\n              'runs': checks, 'descriptions_and_fresh_seeds_verified': True,\n              'runtime_source_hashes_verified': len(code), 'program_source': source,\n              'program_sha256': hashlib.sha256(source.encode()).hexdigest()}\n    (EXPERIMENT / 'control_repetition.json').write_text(json.dumps(output, indent=2) + '\\n')\n    print(json.dumps({'verified_labels': list(checks), 'controls': comparisons,\n                      'runtime_source_hashes_verified': len(code)}))\n\n\nif __name__ == '__main__':\n    main()\n",
  "program_sha256": "a376222af19e6b1d0428b0f2db751d8eb35e97dfbecd332feaa8e051376b4ea6"

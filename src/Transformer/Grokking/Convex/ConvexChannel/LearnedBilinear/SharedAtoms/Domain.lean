module

public import Transformer.Grokking.Convex.ConvexChannel.LearnedBilinear.SharedAtoms.Basic

/-!
# A convex domain generated by all bounded learned complex components

Source: `review/convex/moments.md`, CM92. The dictionary is the entire family
of bounded complex factors, not a fixed finite feature bank. Finite mixtures
execute each learned component. Convexity is in the complete joint tensor;
it is not asserted in the three independently varied factor arrays. Finding
a good component, or a globally optimal linear oracle, remains algorithmic work.
-/

@[expose] public section

namespace Transformer.Grokking.Convex.ConvexChannel.LearnedBilinear.SharedAtoms

open scoped BigOperators
open Identification
open LearnedHinge (Prefix)

variable {O : Type*} [Fintype O] {T : ℕ}

/-- The entire scaled unit component family, CM92. No input or target
table enters this set, and every original class coordinate remains present. -/
def generators (B : ℝ) : Set (RealCoordinate O T → ℝ) :=
  {r | ∃ f : Atom O T, Unit f ∧ r = B • encode (joint f)}

/-- Complete convex shared-component domain, CM92. Every member has a
finite executable factor representation, proved below. -/
def domain (B : ℝ) : Set (RealCoordinate O T → ℝ) := convexHull ℝ (generators B)

/-- Convexity concerns the full joint state, CM92; the finite representation
theorem makes explicit what must be executed or discovered by a learner. -/
theorem domain_convex (B : ℝ) : Convex ℝ (domain B : Set (RealCoordinate O T → ℝ)) :=
  convex_convexHull ℝ _

/-- Every admissible learned component belongs to the joint domain, CM92. -/
theorem generator_mem (B : ℝ) (f : Atom O T) (hf : Unit f) :
    B • encode (joint f) ∈ domain B :=
  subset_convexHull ℝ _ ⟨f, hf, rfl⟩

/-- Exact zero is feasible without sacrificing any original class, CM92. -/
theorem zero_mem (B : ℝ) : (0 : RealCoordinate O T → ℝ) ∈ domain B := by
  have h := generator_mem B (zeroAtom : Atom O T) zero_unit
  have hz : encode (joint (zeroAtom : Atom O T)) = 0 := by
    funext z
    rcases z with ⟨b, c, q, d⟩
    cases b <;> simp [encode, joint, zeroAtom]
  simpa only [hz, smul_zero] using h

/-- Every finite mixture of learned unit components is feasible, CM92.
Zero components may retain unused budget. There is no rank threshold. -/
theorem finite_feasible {J : Type*} [Fintype J] (B : ℝ) (w : J → ℝ) (f : J → Atom O T)
    (hw : ∀ j, 0 ≤ w j) (hmass : ∑ j, w j = 1) (hf : ∀ j, Unit (f j)) :
    (∑ j, w j • (B • encode (joint (f j)))) ∈ domain B := by
  apply mem_convexHull_of_exists_fintype w (fun j => B • encode (joint (f j))) hw hmass
  · intro j
    exact ⟨f j, hf j, rfl⟩
  · rfl

/-- Every joint feasible point has an actual finite factor representation,
CM92. This is existence, not an efficient or globally optimal discovery oracle. -/
theorem finite_representation (B : ℝ) (r : RealCoordinate O T → ℝ) (hr : r ∈ domain B) :
    ∃ (J : Type) (_ : Fintype J) (w : J → ℝ) (f : J → Atom O T),
      (∀ j, 0 ≤ w j) ∧ (∑ j, w j = 1) ∧ (∀ j, Unit (f j)) ∧
        r = ∑ j, w j • (B • encode (joint (f j))) := by
  obtain ⟨J, hJ, w, z, hw, hm, hz, hrz⟩ := mem_convexHull_iff_exists_fintype.mp hr
  choose f hf heq using hz
  refine ⟨J, hJ, w, f, hw, hm, hf, ?_⟩
  rw [← hrz]
  apply Finset.sum_congr rfl
  intro j hj
  rw [heq j]

/-- Complete real energy under a scalar change, CM92. -/
theorem scaled_energy {Z : Type*} [Fintype Z] (B : ℝ) (r : Z → ℝ) :
    Capacity.energy (B • r) = B ^ 2 * Capacity.energy r := by
  simp [Capacity.energy, Pi.smul_apply, smul_eq_mul, mul_pow, Finset.mul_sum]

/-- Atomic budget implies a complete squared-coordinate budget, CM92.
It may be strictly stronger: the converse is neither assumed nor claimed. -/
theorem domain_energy (B : ℝ) (r : RealCoordinate O T → ℝ) (hr : r ∈ domain B) :
    Capacity.energy r ≤ B ^ 2 := by
  apply convexHull_min (t := {r | Capacity.energy r ≤ B ^ 2}) ?_
    (Capacity.energyBall_convex (B ^ 2)) hr
  rintro s ⟨f, hf, rfl⟩
  change Capacity.energy (B • encode (joint f)) ≤ B ^ 2
  rw [scaled_energy]
  simpa using mul_le_mul_of_nonneg_left (unit_energy f hf) (sq_nonneg B)

/-- Ordinary original-object CE is jointly convex on the atomic domain,
CM92. This uses the actual learned sequence path and every output class. -/
theorem loss_convex [DecidableEq O] (B : ℝ) (tokens : Prefix O (T + 1)) (target : O) :
    ConvexOn ℝ (domain B) (fun r : RealCoordinate O T → ℝ =>
      sequenceLoss tokens target (decode r)) := by
  exact (Capacity.bounded_loss_convex tokens target (B ^ 2)).subset
    (fun r hr => domain_energy B r hr) (domain_convex B)

/-- A convex component update stays feasible for any learned unit
candidate, CM92. Global optimality of candidate discovery is not presumed. -/
theorem step_feasible (B eta : ℝ) (r : RealCoordinate O T → ℝ) (f : Atom O T)
    (hr : r ∈ domain B) (hf : Unit f) (he : 0 ≤ eta) (he1 : eta ≤ 1) :
    (1 - eta) • r + eta • (B • encode (joint f)) ∈ domain B :=
  domain_convex B hr (generator_mem B f hf) (by linarith) he (by ring)

example (B : ℝ) : B • encode (joint (zeroAtom : Atom Bool 1)) ∈ domain B :=
  generator_mem B _ zero_unit

example (B : ℝ) : (∑ _ : Fin 1, (1 : ℝ) •
    (B • encode (joint (zeroAtom : Atom Bool 1)))) ∈ domain B :=
  finite_feasible B (fun _ => 1) (fun _ : Fin 1 => zeroAtom)
    (by norm_num) (by simp) (fun _ => zero_unit)

example : ∃ (J : Type) (_ : Fintype J) (w : J → ℝ) (f : J → Atom Bool 1),
    (∀ j, 0 ≤ w j) ∧ (∑ j, w j = 1) ∧ (∀ j, Unit (f j)) ∧
      (0 : RealCoordinate Bool 1 → ℝ) = ∑ j, w j • ((1 : ℝ) • encode (joint (f j))) :=
  finite_representation 1 0 (zero_mem 1)

example : Capacity.energy (0 : RealCoordinate Bool 1 → ℝ) ≤ (1 : ℝ) ^ 2 :=
  domain_energy 1 0 (zero_mem 1)

example : (1 - (1 / 2 : ℝ)) • (0 : RealCoordinate Bool 1 → ℝ) +
    (1 / 2 : ℝ) • ((1 : ℝ) • encode (joint (zeroAtom : Atom Bool 1))) ∈ domain 1 :=
  step_feasible 1 (1 / 2) 0 zeroAtom (zero_mem 1) zero_unit (by norm_num) (by norm_num)

end Transformer.Grokking.Convex.ConvexChannel.LearnedBilinear.SharedAtoms

import Transformer.AMSGrad.Section4_TheoremAActualRun

/-
# AMSGrad — a scalar proof step fails on an actual run

The scalar bound with Theorem A's printed constants fails at `T = 16` for the
admissible AMSGrad run constructed in the preceding two modules, with the
feasible comparator `x* = -1`. The input gradients are linear costs and the
iterates are generated by Algorithm 1. This disproves the scalar step used
by the attempted proof; it does not refute Theorem A's regret inequality.

Source: arXiv:1904.03590v4, §1, Theorem A; §3, Lemma 3.1 and its proof audit.
-/

open Finset
namespace Transformer.AMSGrad

/-- The printed scalar bound fails for the explicit alternating sequences
`a_t = √t/100`, `β_t = 1/2` at even times, and `u_t = 4` at even times.
The difference is strictly positive at `T = 16`.
Source: arXiv:1904.03590v4, §3, the telescoping step of Theorem A. -/
private theorem flip_scalar_gap :
    4 * flipA 16 / (1 - (1 / 2 : ℝ)) +
      4 / (2 * (1 - (1 / 2 : ℝ))) *
        ∑ t ∈ Icc 1 16, flipBeta t * flipA t <
      (∑ t ∈ Icc 1 16, flipA t / (2 * (1 - flipBeta t)) *
        (flipU t - flipU (t + 1))) +
      ∑ t ∈ Icc 2 16, flipBeta t * flipA (t - 1) /
        (2 * (1 - (1 / 2 : ℝ))) * flipU t := by
  norm_num [flipA, flipBeta, flipU, sum_Icc_succ_top]
  ring_nf
  have h2 : (1 : ℝ) ≤ Real.sqrt 2 := by
    calc (1 : ℝ) = Real.sqrt 1 := by norm_num
      _ ≤ Real.sqrt 2 := Real.sqrt_le_sqrt (by norm_num)
  have hs4 : Real.sqrt 4 = (2 : ℝ) := by
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 4), Real.sqrt_nonneg 4]
  have hs9 : Real.sqrt 9 = (3 : ℝ) := by
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 9), Real.sqrt_nonneg 9]
  have h4 : (2 : ℝ) ≤ Real.sqrt 4 := hs4.ge
  have h6 : (2 : ℝ) ≤ Real.sqrt 6 := by
    calc (2 : ℝ) = Real.sqrt 4 := hs4.symm
      _ ≤ Real.sqrt 6 := Real.sqrt_le_sqrt (by norm_num)
  have h8 : (2 : ℝ) ≤ Real.sqrt 8 := by
    calc (2 : ℝ) = Real.sqrt 4 := hs4.symm
      _ ≤ Real.sqrt 8 := Real.sqrt_le_sqrt (by norm_num)
  have h10 : (3 : ℝ) ≤ Real.sqrt 10 := by
    calc (3 : ℝ) = Real.sqrt 9 := hs9.symm
      _ ≤ Real.sqrt 10 := Real.sqrt_le_sqrt (by norm_num)
  have h12 : (3 : ℝ) ≤ Real.sqrt 12 := by
    calc (3 : ℝ) = Real.sqrt 9 := hs9.symm
      _ ≤ Real.sqrt 12 := Real.sqrt_le_sqrt (by norm_num)
  have h14 : (3 : ℝ) ≤ Real.sqrt 14 := by
    calc (3 : ℝ) = Real.sqrt 9 := hs9.symm
      _ ≤ Real.sqrt 14 := Real.sqrt_le_sqrt (by norm_num)
  have h16 : Real.sqrt 16 ≤ (4 : ℝ) := by
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 16), Real.sqrt_nonneg 16]
  linarith

/-- The scalar weight extracted from the actual AMSGrad run.
Source: arXiv:1904.03590v4, §3, Lemma 3.1. -/
private noncomputable def actualA (t : ℕ) : ℝ :=
  Real.sqrt (flipSetup.vhat amsgradRule t 0) / flipSetup.α t

/-- Squared distance from the comparator in the actual run.
Source: arXiv:1904.03590v4, §3, Lemma 3.1. -/
private noncomputable def actualU (t : ℕ) : ℝ :=
  (flipSetup.x amsgradRule t 0 - (-1)) ^ 2

/-- The actual scalar weight matches its closed form on positive times.
Source: arXiv:1904.03590v4, §3, Lemma 3.1. -/
private theorem actualA_eq {t : ℕ} (ht : 1 ≤ t) : actualA t = flipA t := flip_a_eq ht

/-- The actual squared distance matches its closed form through step seventeen.
Source: arXiv:1904.03590v4, §3, Lemma 3.1. -/
private theorem actualU_eq {t : ℕ} (ht : 1 ≤ t) (hT : t ≤ 17) :
    actualU t = flipU t := flip_u_eq ht hT

/-- The time hypotheses of the two closed-form identities have a witness.
Source: arXiv:1904.03590v4, §3, Lemma 3.1. -/
example : (1 ≤ 1) ∧ (1 ≤ 17) := by norm_num

/-- The strict scalar gap after substituting the actual AMSGrad iterates.
Source: arXiv:1904.03590v4, §3, Theorem A proof audit. -/
private theorem actual_scalar_gap :
    4 * actualA 16 / (1 - (1 / 2 : ℝ)) +
      4 / (2 * (1 - (1 / 2 : ℝ))) *
        ∑ t ∈ Icc 1 16, flipBeta t * actualA t <
      (∑ t ∈ Icc 1 16, actualA t / (2 * (1 - flipBeta t)) *
        (actualU t - actualU (t + 1))) +
      ∑ t ∈ Icc 2 16, flipBeta t * actualA (t - 1) /
        (2 * (1 - (1 / 2 : ℝ))) * actualU t := by
  have hR : (∑ t ∈ Icc 1 16, flipBeta t * actualA t) =
      ∑ t ∈ Icc 1 16, flipBeta t * flipA t := by
    apply sum_congr rfl
    intro t ht
    rw [actualA_eq (mem_Icc.mp ht).1]
  have hL1 : (∑ t ∈ Icc 1 16, actualA t / (2 * (1 - flipBeta t)) *
        (actualU t - actualU (t + 1))) =
      ∑ t ∈ Icc 1 16, flipA t / (2 * (1 - flipBeta t)) *
        (flipU t - flipU (t + 1)) := by
    apply sum_congr rfl
    intro t ht
    have ht' := mem_Icc.mp ht
    rw [actualA_eq (mem_Icc.mp ht).1,
      actualU_eq ht'.1 (by omega),
      actualU_eq (by omega : 1 ≤ t + 1) (by omega : t + 1 ≤ 17)]
  have hL2 : (∑ t ∈ Icc 2 16, flipBeta t * actualA (t - 1) /
        (2 * (1 - (1 / 2 : ℝ))) * actualU t) =
      ∑ t ∈ Icc 2 16, flipBeta t * flipA (t - 1) /
        (2 * (1 - (1 / 2 : ℝ))) * flipU t := by
    apply sum_congr rfl
    intro t ht
    have ht' := mem_Icc.mp ht
    rw [actualA_eq (by omega : 1 ≤ t - 1),
      actualU_eq (by omega : 1 ≤ t) (by omega : t ≤ 17)]
  rw [actualA_eq (by norm_num : 1 ≤ 16), hR, hL1, hL2]
  exact flip_scalar_gap

/-- The total cost through step sixteen is `(19/6)x`.
Source: arXiv:1904.03590v4, §1, regret comparator for Theorem A. -/
theorem flip_cost_sum (x : Vec 1) :
    ∑ t ∈ Icc 1 16, flipSetup.f t x = (19 / 6 : ℝ) * x 0 := by
  norm_num [sum_Icc_succ_top, flipSetup, flipCoef]
  ring

/-- The comparator `-1` used in the scalar gap minimizes the total cost over
the feasible interval, as in the paper's regret definition.
Source: arXiv:1904.03590v4, §1, Theorem A. -/
theorem flip_best_comparator (x : Vec 1)
    (hx : x ∈ Set.Icc (fun _ => -1) (fun _ => 1)) :
    (∑ t ∈ Icc 1 16, flipSetup.f t (fun _ => -1)) ≤
      ∑ t ∈ Icc 1 16, flipSetup.f t x := by
  rw [flip_cost_sum, flip_cost_sum]
  have hxmin := hx.1 0
  norm_num at hxmin ⊢
  linarith

/-- The comparator hypothesis in `flip_best_comparator` has a witness.
Source: arXiv:1904.03590v4, §1, Theorem A. -/
example : (fun _ : Fin 1 => (-1 : ℝ)) ∈ Set.Icc (fun _ => -1) (fun _ => 1) :=
  ⟨fun _ => le_rfl, fun _ => by norm_num⟩

/-- **The printed scalar bound fails on an admissible AMSGrad trajectory.**
At `T = 16`, take the one-dimensional run `flipSetup` and comparator `x*=-1`.
Its schedule satisfies `β₁ = β₁,₁ = 1/2`, `0 ≤ β₁,t ≤ β₁`, and
`β₁/√β₂ < 1`; `flip_isOnlineConvex` proves the other standing hypotheses.
The scalar estimate used to reduce Lemma 3.1 to Theorem A's printed constants
is strictly reversed. `flip_best_comparator` shows that `-1` minimizes the
total cost. This does not refute the regret inequality itself.

Source: arXiv:1904.03590v4, §1, Theorem A; §3, Lemma 3.1 and proof audit. -/
theorem not_abel_printed_actual_run :
    ¬ ((∑ t ∈ Icc 1 16,
        (Real.sqrt (flipSetup.vhat amsgradRule t 0) / flipSetup.α t) /
          (2 * (1 - flipSetup.β₁ t)) *
          ((flipSetup.x amsgradRule t 0 - (-1)) ^ 2 -
            (flipSetup.x amsgradRule (t + 1) 0 - (-1)) ^ 2)) +
      ∑ t ∈ Icc 2 16, flipSetup.β₁ t *
        (Real.sqrt (flipSetup.vhat amsgradRule (t - 1) 0) / flipSetup.α (t - 1)) /
          (2 * (1 - flipSetup.β₁ 1)) *
          (flipSetup.x amsgradRule t 0 - (-1)) ^ 2 ≤
      4 * (Real.sqrt (flipSetup.vhat amsgradRule 16 0) / flipSetup.α 16) /
        (1 - flipSetup.β₁ 1) +
      4 / (2 * (1 - flipSetup.β₁ 1)) *
        ∑ t ∈ Icc 1 16, flipSetup.β₁ t *
          (Real.sqrt (flipSetup.vhat amsgradRule t 0) / flipSetup.α t)) := by
  have hb1 := flip_params.1
  rw [hb1]
  change ¬ ((∑ t ∈ Icc 1 16, actualA t / (2 * (1 - flipBeta t)) *
    (actualU t - actualU (t + 1))) +
    ∑ t ∈ Icc 2 16, flipBeta t * actualA (t - 1) /
      (2 * (1 - (1 / 2 : ℝ))) * actualU t ≤
    4 * actualA 16 / (1 - (1 / 2 : ℝ)) +
    4 / (2 * (1 - (1 / 2 : ℝ))) *
      ∑ t ∈ Icc 1 16, flipBeta t * actualA t)
  exact not_le.mpr actual_scalar_gap

end Transformer.AMSGrad

/-
# Brownian motion, the cylindrical Wiener process and its filtrations

*Homogenized Transformers*, arXiv:2604.01978v1, App. A.2
`sec: cylindrical.wiener` and §2.4 `note:probabilistic_setting`.

An `(ℱ_t)`-Brownian motion of variance `v` (`IsBrownian`) starts at `0`, has
continuous paths, is adapted, and its increment `B_t - B_s`, `s ≤ t`, is
independent of `ℱ_s` with law `𝒩(0, v (t - s))`.  A cylindrical Wiener process
on `L²(ρ)` (`IsCylindricalWiener`) is linear in `h ∈ L²(ρ)` and, for each `h`,
an `(ℱ_t)`-Brownian motion of variance `‖h‖²`.

§2.4 builds its filtrations from the noise: `ℱ_t^{W,0}`, generated by the noise
up to time `t` (`noiseFiltration`); its usual augmentation `ℱ_t^W`
(`wienerFiltration`); and the usual augmentation of the filtration generated by
the initial data and the noise (`wienerFiltrationWith`).  The usual
augmentation (`augment`) adds the `P`-null sets and passes to the right
continuation.  `UsualConditions` collects completeness, the null sets in `ℱ_0`
and right continuity; `IndepOfWiener` is the independence of the initial datum
from the noise.

Deviations from the source:
* `W(t)` is a family of representatives `W t h : Ω → ℝ`, linear in `h` up to
  `P`-null sets, instead of a linear operator into `L²(Ω; P)`, whose elements
  are classes; square integrability follows from the Gaussian laws.
* `ℱ_t^{W,0}` is generated by all `W(s)[h]`, `s ≤ t`, `h ∈ L²(ρ)`, instead of
  the Brownian motions `β^k = W(·)[e_k]` of an orthonormal basis `(e_k)` of
  `L²(ρ)`; the two differ by null sets, so their augmentations coincide.
* Time is `ℝ≥0`.
* `ρ` is any measure: separability of `L²(ρ)` and `ρ(Θ) = 1` are assumed only
  where used.
-/

import Mathlib.Probability.Distributions.Gaussian.Real
import Mathlib.Probability.HasLaw
import Mathlib.Probability.Independence.Basic
import Mathlib.Probability.Process.Adapted

open MeasureTheory ProbabilityTheory Filter
open scoped NNReal ENNReal

namespace Transformer.Wiener

variable {Ω Θ E : Type*} {m : MeasurableSpace Ω} {mΘ : MeasurableSpace Θ}
  [mE : MeasurableSpace E] {P : Measure Ω} {ℱ : Filtration ℝ≥0 m} {ρ : Measure Θ}

/-- **An `(ℱ_t)`-Brownian motion of variance `v`** (App. A.2, item 2): `B_0 = 0`
almost surely, almost every path is continuous, `B` is adapted to `ℱ`, and for
`s ≤ t` the increment `B_t - B_s` is independent of `ℱ_s` with law
`𝒩(0, v (t - s))`.  The law of `B_t - B_t = 0` makes `P` a probability
measure (`IsBrownian.isProbabilityMeasure`). -/
structure IsBrownian (ℱ : Filtration ℝ≥0 m) (P : Measure Ω) (v : ℝ≥0)
    (B : ℝ≥0 → Ω → ℝ) : Prop where
  zero : B 0 =ᵐ[P] 0
  continuous : ∀ᵐ ω ∂P, Continuous fun t => B t ω
  adapted : StronglyAdapted ℱ B
  indep : ∀ s t, s ≤ t → Indep (MeasurableSpace.comap (B t - B s) inferInstance) (ℱ s) P
  hasLaw : ∀ s t, s ≤ t → HasLaw (B t - B s) (gaussianReal 0 (v * (t - s))) P

/-- A Brownian motion lives on a probability space: `B_t - B_t = 0` has law
`𝒩(0, 0) = δ_0`. -/
theorem IsBrownian.isProbabilityMeasure {v : ℝ≥0} {B : ℝ≥0 → Ω → ℝ} (hB : IsBrownian ℱ P v B) :
    IsProbabilityMeasure P := by
  have h := congrArg (· Set.univ) (hB.hasLaw 0 0 le_rfl).map_eq
  simp only [sub_self, Pi.zero_def, Measure.map_const, tsub_self, mul_zero,
    gaussianReal_zero_var] at h
  exact ⟨by simpa using h⟩

/-- **A cylindrical Wiener process on `L²(ρ)`** (App. A.2, `sec: cylindrical.wiener`):
each `W(t)` is linear on `L²(ρ)`, here up to `P`-null sets, and for each
`h ∈ L²(ρ)` the process `(W(t)[h])_{t ≥ 0}` is an `(ℱ_t)`-Brownian motion with
`Var(W(t)[h]) = t ‖h‖²_{L²(ρ)}`. -/
structure IsCylindricalWiener (ρ : Measure Θ) (ℱ : Filtration ℝ≥0 m) (P : Measure Ω)
    (W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ) : Prop where
  linear : ∀ t (a : ℝ) (h g : Lp ℝ 2 ρ), W t (a • h + g) =ᵐ[P] a • W t h + W t g
  brownian : ∀ h, IsBrownian ℱ P (‖h‖₊ ^ 2) fun t => W t h

/-- Each `W(t)[h]` is measurable, being `ℱ_t`-measurable. -/
theorem IsCylindricalWiener.measurable {W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ}
    (hW : IsCylindricalWiener ρ ℱ P W) (t : ℝ≥0) (h : Lp ℝ 2 ρ) : Measurable (W t h) :=
  (((hW.brownian h).adapted t).mono (ℱ.le t)).measurable

/-- **The noise filtration** `ℱ_t^{W,0} = σ(W(s)[h] : s ≤ t, h ∈ L²(ρ))` (§2.4),
for a measurable noise. -/
def noiseFiltration (W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ)
    (hW : ∀ t h, Measurable (W t h)) : Filtration ℝ≥0 m where
  seq t := ⨆ s ≤ t, ⨆ h, MeasurableSpace.comap (W s h) inferInstance
  mono' _ _ hst := iSup₂_mono' fun s hs => ⟨s, hs.trans hst, le_rfl⟩
  le' _ := iSup₂_le fun s _ => iSup_le fun h => (hW s h).comap_le

/-- The σ-algebra `σ(𝒩_P)` generated by the `P`-null sets, the sets `s` with
`P s = 0`. -/
@[instance_reducible]
def nullSigma (P : Measure Ω) : MeasurableSpace Ω :=
  MeasurableSpace.generateFrom {s | P s = 0}

/-- Under a complete `P` the null sets are measurable. -/
theorem nullSigma_le [hP : P.IsComplete] : nullSigma P ≤ m :=
  MeasurableSpace.generateFrom_le fun s hs => hP.out' s hs

/-- **The usual augmentation** of `𝒢` under a complete `P`: the right
continuation `ℱ_t = ⋂_{u > t} σ(𝒢_u ∪ 𝒩_P)` of `𝒢` enlarged by the `P`-null
sets. -/
noncomputable def augment (P : Measure Ω) [P.IsComplete] (𝒢 : Filtration ℝ≥0 m) :
    Filtration ℝ≥0 m :=
  (𝒢 ⊔ Filtration.const ℝ≥0 (nullSigma P) nullSigma_le).rightCont

/-- **`ℱ_t^W`** (§2.4): the usual augmentation of the noise filtration
`ℱ_t^{W,0}`. -/
noncomputable def wienerFiltration (P : Measure Ω) [P.IsComplete]
    (W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ) (hW : ∀ t h, Measurable (W t h)) : Filtration ℝ≥0 m :=
  augment P (noiseFiltration W hW)

/-- **The filtration `ℱ_t` of §2.4**: the usual augmentation of the filtration
generated by the initial datum `x₀` and the noise up to time `t`.  The source
generates it by the tokens `x_1, …, x_n` (one token `x_0` in
`def:nonlinear_SDE_common`); for the tuple `x₀ = (x_1, …, x_n)`,
`σ(x₀) = σ(x_1, …, x_n)`. -/
noncomputable def wienerFiltrationWith (P : Measure Ω) [P.IsComplete] (x₀ : Ω → E)
    (hx₀ : Measurable x₀) (W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ) (hW : ∀ t h, Measurable (W t h)) :
    Filtration ℝ≥0 m :=
  augment P (Filtration.const ℝ≥0 (MeasurableSpace.comap x₀ mE) hx₀.comap_le ⊔
    noiseFiltration W hW)

/-- **The usual conditions** on a filtered space: `P` is complete, `ℱ_0` contains
the `P`-null sets, and `ℱ` is right-continuous.  App. A.2 assumes a complete
space and a right-continuous filtration; the usual augmentation of §2.4 also
puts the null sets in `ℱ_0`. -/
structure UsualConditions (ℱ : Filtration ℝ≥0 m) (P : Measure Ω) : Prop where
  isComplete : P.IsComplete
  measurableSet_of_null : ∀ s, P s = 0 → MeasurableSet[ℱ 0] s
  isRightContinuous : ℱ.IsRightContinuous

/-- **The initial datum is independent of the noise**
(`def:nonlinear_SDE_common`, `prop:mckean_vlasov_common_noise`): `σ(x₀)` is
independent of `σ(W(t)[h] : t ≥ 0, h ∈ L²(ρ))`. -/
def IndepOfWiener (x₀ : Ω → E) (W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ) (P : Measure Ω) : Prop :=
  Indep (MeasurableSpace.comap x₀ mE) (⨆ t, ⨆ h, MeasurableSpace.comap (W t h) inferInstance) P

/-- **The zero process is a Brownian motion of variance `0`** under a
probability measure, for every filtration. -/
theorem isBrownian_zero [IsProbabilityMeasure P] (ℱ : Filtration ℝ≥0 m) :
    IsBrownian ℱ P 0 fun _ _ => 0 := by
  have h0 : ∀ s t : ℝ≥0, (fun _ _ => (0 : ℝ)) t - (fun _ _ => (0 : ℝ)) s = fun _ : Ω => (0 : ℝ) :=
    fun _ _ => sub_self _
  refine ⟨EventuallyEq.rfl, ae_of_all _ fun _ => continuous_const,
    fun _ => stronglyMeasurable_const, fun s t _ => ?_, fun s t _ => ?_⟩
  · rw [h0 s t, MeasurableSpace.comap_const]
    exact indep_bot_left _
  · rw [h0 s t, zero_mul, gaussianReal_zero_var]
    exact ⟨aemeasurable_const, by simp⟩

/-- **The zero process is a cylindrical Wiener process on `L²(0)`**: under the
zero measure every `h ∈ L²` has norm `0`. -/
theorem isCylindricalWiener_zero [IsProbabilityMeasure P] (ℱ : Filtration ℝ≥0 m) :
    IsCylindricalWiener (0 : Measure Θ) ℱ P fun _ _ _ => 0 := by
  refine ⟨fun _ _ _ _ => ae_of_all _ fun _ => by simp, fun h => ?_⟩
  have hh : ‖h‖₊ = 0 := by simp [Lp.nnnorm_def]
  rw [hh, zero_pow two_ne_zero]
  exact isBrownian_zero ℱ

/-- **A constant filtration `ℱ_t = m` satisfies the usual conditions** under a
complete `P`. -/
theorem usualConditions_const [hP : P.IsComplete] :
    UsualConditions (Filtration.const ℝ≥0 m le_rfl) P :=
  ⟨hP, fun s hs => hP.out' s hs, ⟨fun t => Filtration.le _ t⟩⟩

/-- The hypotheses of `isBrownian_zero`, `isCylindricalWiener_zero` (hence of
`IsBrownian.isProbabilityMeasure` and `IsCylindricalWiener.measurable`),
`nullSigma_le` and `usualConditions_const` hold for the point mass on `Unit`, a
complete probability measure: there the zero process is a Brownian motion of
variance `0` and a cylindrical Wiener process on `L²(0)`, and the constant
filtration satisfies the usual conditions. -/
example : IsBrownian (Filtration.const ℝ≥0 _ le_rfl) (Measure.dirac ()) 0 (fun _ _ => 0) ∧
    IsCylindricalWiener (0 : Measure ℝ) (Filtration.const ℝ≥0 _ le_rfl) (Measure.dirac ())
      (fun _ _ _ => 0) ∧
    nullSigma (Measure.dirac ()) ≤ (inferInstance : MeasurableSpace Unit) ∧
    UsualConditions (Filtration.const ℝ≥0 _ le_rfl) (Measure.dirac ()) := by
  have : (Measure.dirac ()).IsComplete := ⟨fun _ _ => Subsingleton.measurableSet⟩
  exact ⟨isBrownian_zero _, isCylindricalWiener_zero _, nullSigma_le, usualConditions_const⟩

/-- The zero noise is independent of every initial datum. -/
example (x₀ : Ω → E) [IsProbabilityMeasure P] :
    IndepOfWiener x₀ (fun _ _ _ => 0 : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ) P := by
  simp only [IndepOfWiener, MeasurableSpace.comap_const, iSup_bot]
  exact indep_bot_right _

end Transformer.Wiener

{
  "collected_utc": "2026-10-05T02:35:07Z",
  "scope": "All 60 repair runs; trajectory data retained in the two referenced screen artifacts",
  "code_commit": "aadc7728c7309d5491f2093796f94dd659329c4e",
  "program_source": "\"\"\"Combine both complete screens without duplicating their attention trajectories.\n\nThe ranking selects the best attempted intervention for mod 193. It does\nnot turn a failed basis criterion into a successful repair.\n\"\"\"\n\nimport hashlib\nimport json\nfrom pathlib import Path\nimport time\n\n\nROOT = Path('/home/misha/lean_projects/transformer/experiments/basis_sparsemax')\nCANDIDATES = ('qknorm-one', 'scaleddot')\n\n\ndef sha(path):\n    with path.open('rb') as source:\n        return hashlib.file_digest(source, 'sha256').hexdigest()\n\n\ndef collect():\n    screens = {size: json.loads((ROOT / f'{size}_repair_results.json').read_text())\n               for size in ('small', 'large')}\n    assert screens['small']['code_commit'] == screens['large']['code_commit']\n    assert screens['small']['runtime_code_sha256'] == screens['large']['runtime_code_sha256']\n    assert screens['small']['experiment_source_sha256'] == screens['large']['experiment_source_sha256']\n    runs = {label: run for screen in screens.values() for label, run in screen['runs'].items()}\n    assert len(runs) == 60\n    for screen in screens.values():\n        assert hashlib.sha256(screen['program_source'].encode()).hexdigest() == screen['program_sha256']\n        assert hashlib.sha256(screen['helper_source'].encode()).hexdigest() == screen['helper_sha256']\n        for run in screen['runs'].values():\n            assert run['runtime_source_code_verified']\n            for name, checksum in run['source'].items():\n                assert sha(ROOT / name) == checksum, name\n    comparisons = {}\n    for candidate in CANDIDATES:\n        chosen = {label: run for label, run in runs.items() if run['comparison']['candidate'] == candidate}\n        required = {label: run for label, run in chosen.items() if run['comparison']['required_softmax_pass']}\n        matched = [label for label, run in required.items() if run['pass_step'] is not None]\n        sparse = [label for label in matched if chosen[label]['final_sparsity']['has_exact_visible_zeros']]\n        persistent = [f'repair-{candidate}-hard-large-recall-seed{seed}' for seed in (1, 2)]\n        all_sparse_passes = [label for label, run in chosen.items()\n                            if run['pass_step'] is not None and run['final_sparsity']['has_exact_visible_zeros']]\n        assert len(chosen) == 30 and len(required) == 22\n        comparisons[candidate] = {\n            'runs': 30, 'required_softmax_passes': 22, 'matched_required_passes': len(matched),\n            'sparse_matched_required_passes': len(sparse),\n            'persistent_target_passes': sum(chosen[label]['pass_step'] is not None for label in persistent),\n            'all_passes': sum(run['pass_step'] is not None for run in chosen.values()),\n            'all_sparse_passes': len(all_sparse_passes),\n            'passes_basis_repair_criterion': len(sparse) == 22,\n            'unmatched_softmax_labels': [label for label in required if label not in matched],\n            'dense_only_passing_labels': [label for label in matched if label not in sparse],\n            'cells': {label: {'stop': run['stop'], 'pass_step': run['pass_step'],\n                             'softmax_pass_step': run['comparison']['softmax_pass_step'],\n                             'sparsemax_pass_step': run['comparison']['sparsemax_pass_step'],\n                             'best_sequence_accuracy': run['best_sequence_accuracy'],\n                             'last_training_batch_loss': run['last_training_batch_loss'],\n                             'final_sparsity': run['final_sparsity']}\n                      for label, run in chosen.items()},\n        }\n    ranking = sorted(CANDIDATES, key=lambda candidate: (\n        -comparisons[candidate]['sparse_matched_required_passes'],\n        -comparisons[candidate]['persistent_target_passes'],\n        -comparisons[candidate]['all_sparse_passes'], CANDIDATES.index(candidate)))\n    source = Path(__file__).read_text()\n    summary = {\n        'collected_utc': time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime()),\n        'scope': 'All 60 repair runs; trajectory data retained in the two referenced screen artifacts',\n        'code_commit': screens['small']['code_commit'], 'program_source': source,\n        'program_sha256': hashlib.sha256(source.encode()).hexdigest(),\n        'screen_sources': {f'{size}_repair_results.json': sha(ROOT / f'{size}_repair_results.json')\n                           for size in screens},\n        'comparisons': comparisons, 'ranking': ranking,\n        'ranking_rule': 'Sparse matched softmax passes, then persistent target passes, then all sparse passes; stable candidate order breaks an exact tie',\n        'best_attempt_for_mod193': ranking[0],\n        'best_attempt_passes_basis_repair_criterion': comparisons[ranking[0]]['passes_basis_repair_criterion'],\n    }\n    (ROOT / 'repair_results.json').write_text(json.dumps(summary, indent=2) + '\\n')\n    print(json.dumps({candidate: {key: value for key, value in record.items() if key != 'cells'}\n                      for candidate, record in comparisons.items()}, indent=2), flush=True)\n    print(json.dumps({'ranking': ranking, 'best_attempt_for_mod193': ranking[0]}), flush=True)\n\n\nif __name__ == '__main__':\n    collect()\n",
  "program_sha256": "8121c405c38374eb2a301ee7f880286b94f51153161029832359332f73decc0d",

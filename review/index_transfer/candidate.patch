index 00000000..322f648d
--- /dev/null
+++ b/python/src/lab/infrastructure/engine/indices.py
@@ -0,0 +1,33 @@
+"""Reuse sampler permutations on the training device.
+
+Source: GraphStepper.stage/upload at0f457bac. Unlike its pinned reusable
+buffer, this cache makes one blocking copy per sampler tensor/version and
+returns views into that copy. Batches that cross permutations concatenate
+their views. Sampler state stays on the CPU and its random stream is unchanged.
+"""
+
+import torch
+
+
+class SamplerIndices:
+    """A bounded cache of the most recent sampler tensor on one device.
+
+    Samplers replace their permutation or window tensor between draws.
+    Retaining the source prevents object-id reuse; its version also detects
+    PyTorch in-place changes. No mutable pinned host buffer is reused while
+    a device copy is outstanding. This cache is reconstructed after resume.
+    """
+
+    def __init__(self, device):
+        self.device = torch.device(device)
+        self.source = self.version = self.uploaded = None
+
+    def __call__(self, parts):
+        chunks = []
+        for source, start, count in parts:
+            version = source._version
+            if source is not self.source or version != self.version:
+                self.uploaded = source.to(self.device, copy=True)
+                self.source, self.version = source, version
+            chunks.append(self.uploaded[start:start + count])
+        return chunks[0] if len(chunks) == 1 else torch.cat(chunks)
diff --git a/python/tests/test_sampler_indices.py b/python/tests/test_sampler_indices.py
new file mode 100644
index 00000000..5487b65f
--- /dev/null
+++ b/python/tests/test_sampler_indices.py
@@ -0,0 +1,111 @@
+"""Index transport preserves sampler clocks, batches and complete training states."""
+
+import copy
+from pathlib import Path
+import tempfile
+import unittest
+
+import torch
+
+from lab.dsl import ResidualMaxAutotune, describe, swap
+from lab.infrastructure.benchmarks.rotary import LabSampler
+from lab.infrastructure.benchmarks.samplers import EpochSampler, WindowSampler, gather
+from lab.infrastructure.engine.basis_residual import BasisTraining
+from lab.infrastructure.engine.indices import SamplerIndices
+from lab.infrastructure.engine.residual import ResidualCompiledStepper
+from lab.infrastructure.store import RunDirectory
+from test_residual_basis import tiny
+
+
+class PerBatchUpload(ResidualCompiledStepper):
+    """The0f457bac compiled input path; all model and optimizer code is shared."""
+    def __init__(self, *args):
+        super().__init__(*args)
+        self.indices = gather
+
+
+class CachedUpload(ResidualCompiledStepper):
+    """Exercise the cache on CPU too, where production keeps its original path."""
+    def __init__(self, *args):
+        super().__init__(*args)
+        self.indices = SamplerIndices(self.task.device)
+
+
+class SamplerIndicesTests(unittest.TestCase):
+    def setUp(self):
+        torch.set_num_threads(1)
+
+    def test_epochs_windows_wraps_and_restores_preserve_every_draw(self):
+        factories = (lambda: EpochSampler(17, 4, False, 11),
+                     lambda: EpochSampler(5, 13, True, 11),
+                     lambda: WindowSampler(37, 7, 11, block=3),
+                     lambda: LabSampler(17, 4, 11))
+        for factory in factories:
+            reference, candidate = factory(), factory()
+            cached = SamplerIndices("cpu")
+            for step in range(31):
+                if step in (7, 16):
+                    state = copy.deepcopy(candidate.state())
+                    candidate, cached = factory(), SamplerIndices("cpu")
+                    candidate.restore(state)
+                a, place_a = reference.next()
+                b, place_b = candidate.next()
+                torch.testing.assert_close(gather(a), cached(b), rtol=0, atol=0)
+                torch.testing.assert_close(reference.state(), candidate.state(), rtol=0, atol=0)
+                self.assertEqual(place_a, place_b)
+
+    def test_reuse_invalidation_and_prior_batches_are_independent_of_host_mutation(self):
+        cached = SamplerIndices("cpu")
+        source = torch.arange(12)
+        first = cached([(source, 2, 4)])
+        uploaded = cached.uploaded
+        torch.testing.assert_close(cached([(source, 6, 3)]), torch.tensor([6, 7, 8]))
+        self.assertIs(cached.uploaded, uploaded)
+        source.add_(20)
+        torch.testing.assert_close(cached([(source, 2, 4)]), torch.tensor([22, 23, 24, 25]))
+        self.assertIsNot(cached.uploaded, uploaded)
+        torch.testing.assert_close(first, torch.tensor([2, 3, 4, 5]))
+        another = source.clone()
+        uploaded = cached.uploaded
+        cached([(another, 0, 2)])
+        self.assertIs(cached.source, another)
+        self.assertIsNot(cached.uploaded, uploaded)
+
+    def trajectory(self, device):
+        spec = swap(tiny(), "execution", ResidualMaxAutotune(device=device))
+
+        def train(spec, path, stepper):
+            run = RunDirectory(path)
+            run.begin(describe(spec), {}, "Sampler transport equivalence fixture")
+            result = BasisTraining(spec, run, lambda row: None, stepper)()
+            self.assertEqual(result["stop"], {"step": spec.budget.updates, "reason": "budget"})
+            return run
+
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            control = train(spec, root / "control", PerBatchUpload)
+            candidate = train(spec, root / "candidate", CachedUpload)
+            train(swap(spec, "budget.updates", 2), root / "continued", CachedUpload)
+            continued = train(spec, root / "continued", CachedUpload)
+            expected = control.checkpoint("cpu")
+            for run in (candidate, continued):
+                state = run.checkpoint("cpu")
+                for key in ("model", "optimizer", "permutation", "batch_generator_state"):
+                    torch.testing.assert_close(expected[key], state[key], rtol=0, atol=0)
+                for key in ("cursor", "step", "examples_seen", "last_batch_size"):
+                    self.assertEqual(expected[key], state[key])
+                self.assertEqual(control.records("gradients"), run.records("gradients"))
+                a, b = control.records("history"), run.records("history")
+                self.assertEqual([row["validation"] for row in a], [row["validation"] for row in b])
+                self.assertTrue(all("test" not in row for row in b))
+
+    def test_compiled_cpu_cached_indices_preserve_full_trajectory_and_resume(self):
+        self.trajectory("cpu")
+
+    @unittest.skipUnless(torch.cuda.is_available(), "CUDA unavailable")
+    def test_compiled_cuda_cached_indices_preserve_full_trajectory_and_resume(self):
+        self.trajectory("cuda")
+
+
+if __name__ == "__main__":
+    unittest.main()

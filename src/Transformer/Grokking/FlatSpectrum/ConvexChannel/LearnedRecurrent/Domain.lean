module

public import Transformer.Grokking.FlatSpectrum.ConvexChannel.LearnedRecurrent.Basic
public import Transformer.Grokking.FlatSpectrum.ConvexRecall.Loss
public import Transformer.Grokking.FlatSpectrum.ConvexChannel.LearnedHinge.Renaming.Prediction
public import Mathlib.Analysis.Convex.Combination

/-!
# Bounded convex mixtures of complete learned recurrent components

Source: `review/convex/moments.md`, CM95. The joint domain contains functions
on every immutable-object sequence, generated by all learned bounded complex
recurrences. Convexity is in these joint scores, not independent recurrent
parameters. Finite representation does not give an efficient discovery oracle.
-/

@[expose] public section

namespace Transformer.Grokking.FlatSpectrum.ConvexChannel.LearnedRecurrent

open scoped BigOperators

variable (O E : Type*) [NormedAddCommGroup E] [NormedSpace ℂ E]

/-- All learned recurrent generators, CM95, with no observed-label table
or prescribed finite dictionary. -/
def generators (B : ℝ) : Set (List O → O → ℝ) :=
  {r | ∃ f : Parameters O E, Unit f ∧ r = B • score f}

/-- Joint functional capacity domain on all raw sequences, CM95. -/
def domain (B : ℝ) : Set (List O → O → ℝ) := convexHull ℝ (generators O E B)

variable {O E}

/-- Convexity of the full learned recurrent function domain, CM95. -/
theorem domain_convex (B : ℝ) : Convex ℝ (domain O E B) := convex_convexHull ℝ _

/-- Every actual learned admissible recurrence is feasible, CM95. -/
theorem generator_mem (B : ℝ) (f : Parameters O E) (hf : Unit f) :
    B • score f ∈ domain O E B := subset_convexHull ℝ _ ⟨f, hf, rfl⟩

/-- The exact zero function can carry unused mixture mass, CM95. -/
theorem zero_mem (B : ℝ) : (0 : List O → O → ℝ) ∈ domain O E B := by
  have h := generator_mem B (zeroParameters : Parameters O E) zero_unit
  have hz : score (zeroParameters : Parameters O E) = 0 := by
    funext xs c
    exact zero_score xs c
  simpa only [hz, smul_zero] using h

/-- A finite actual recurrent mixture stays within capacity, CM95. -/
theorem finite_feasible {J : Type*} [Fintype J] (B : ℝ) (w : J → ℝ)
    (f : J → Parameters O E) (hw : ∀ j, 0 ≤ w j) (hm : ∑ j, w j = 1)
    (hf : ∀ j, Unit (f j)) :
    (∑ j, w j • (B • score (f j))) ∈ domain O E B := by
  exact mem_convexHull_of_exists_fintype w (fun j => B • score (f j)) hw hm
    (fun j => ⟨f j, hf j, rfl⟩) rfl

/-- Every joint-domain point executes as a finite mixture of learned
complex recurrences on every sequence, CM95. This is an existence theorem. -/
theorem finite_representation (B : ℝ) (r : List O → O → ℝ) (hr : r ∈ domain O E B) :
    ∃ (J : Type) (_ : Fintype J) (w : J → ℝ) (f : J → Parameters O E),
      (∀ j, 0 ≤ w j) ∧ (∑ j, w j = 1) ∧ (∀ j, Unit (f j)) ∧
      r = ∑ j, w j • (B • score (f j)) := by
  obtain ⟨J, hJ, w, z, hw, hm, hz, he⟩ := mem_convexHull_iff_exists_fintype.mp hr
  choose f hf heq using hz
  refine ⟨J, hJ, w, f, hw, hm, hf, ?_⟩
  rw [← he]
  apply Finset.sum_congr rfl
  intro j hj
  rw [heq j]

/-- The joint recurrent scores have a uniform bound at every depth,
CM95. No input length enters the right-hand side. -/
theorem domain_bound (B : ℝ) (hB : 0 ≤ B) (r : List O → O → ℝ)
    (hr : r ∈ domain O E B) (xs : List O) (c : O) : |r xs c| ≤ B := by
  obtain ⟨J, hJ, w, f, hw, hm, hf, rfl⟩ := finite_representation B r hr
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
  calc
    |∑ j, w j * (B * score (f j) xs c)| ≤ ∑ j, |w j * (B * score (f j) xs c)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ j, w j * B := by
      apply Finset.sum_le_sum
      intro j hj
      rw [abs_mul, abs_mul, abs_of_nonneg (hw j), abs_of_nonneg hB]
      have h := mul_le_mul_of_nonneg_left (score_bound (f j) (hf j) xs c)
        (mul_nonneg (hw j) hB)
      simpa only [mul_assoc, mul_one] using h
    _ = B := by rw [← Finset.sum_mul, hm, one_mul]

/-- Reading logits for a raw sequence is linear in the joint function,
CM95. It still executes learned components in the finite representation. -/
def evaluation (xs : List O) : (List O → O → ℝ) →ₗ[ℝ] (O → ℝ) where
  toFun r := r xs
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Ordinary full-vocabulary next-object cross-entropy is convex on the
joint recurrent domain, CM95. -/
theorem loss_convex [Fintype O] (B : ℝ) (xs : List O) (target : O) :
    ConvexOn ℝ (domain O E B) (fun r => Landscape.Neural.crossEntropy (r xs) target) := by
  have h := (ConvexRecall.convex_crossEntropy target).comp_linearMap (evaluation xs)
  have hu : ConvexOn ℝ Set.univ
      (fun r : List O → O → ℝ => Landscape.Neural.crossEntropy (r xs) target) := by
    simpa only [Set.preimage_univ, Function.comp_def, evaluation, LinearMap.coe_mk,
      AddHom.coe_mk] using h
  exact hu.subset (Set.subset_univ _) (domain_convex B)

/-- Any admissible recurrent proposal gives a feasible convex update,
CM95; optimal proposal discovery is not an assumption hidden here. -/
theorem step_feasible (B eta : ℝ) (r : List O → O → ℝ) (f : Parameters O E)
    (hr : r ∈ domain O E B) (hf : Unit f) (he : 0 ≤ eta) (he1 : eta ≤ 1) :
    (1 - eta) • r + eta • (B • score f) ∈ domain O E B :=
  domain_convex B hr (generator_mem B f hf) (by linarith) he (by ring)

/-- The external output is one original object, CM95. Native evaluation
must scan all classes and use a declared deterministic tie rule. -/
noncomputable def nextObject [Fintype O] (r : List O → O → ℝ) (xs : List O) (witness : O) : O :=
  Classical.choose (LearnedHinge.Renaming.winner_exists (r xs) witness)

/-- The returned object maximizes the complete actual scores, CM95. -/
theorem nextObject_max [Fintype O] (r : List O → O → ℝ) (xs : List O) (witness c : O) :
    r xs c ≤ r xs (nextObject r xs witness) :=
  Classical.choose_spec (LearnedHinge.Renaming.winner_exists (r xs) witness) c

example : (1 : ℝ) • score (zeroParameters : Parameters Bool ℂ) ∈ domain Bool ℂ 1 :=
  generator_mem _ _ zero_unit

example : (∑ _ : Fin 1, (1 : ℝ) • ((1 : ℝ) •
    score (zeroParameters : Parameters Bool ℂ))) ∈ domain Bool ℂ 1 :=
  finite_feasible 1 (fun _ => 1) (fun _ : Fin 1 => zeroParameters)
    (by norm_num) (by simp) (fun _ => zero_unit)

example : ∃ (J : Type) (_ : Fintype J) (w : J → ℝ) (f : J → Parameters Bool ℂ),
    (∀ j, 0 ≤ w j) ∧ (∑ j, w j = 1) ∧ (∀ j, Unit (f j)) ∧
    (0 : List Bool → Bool → ℝ) = ∑ j, w j • ((1 : ℝ) • score (f j)) :=
  finite_representation 1 0 (zero_mem 1)

example : |(0 : List Bool → Bool → ℝ) [true, false] true| ≤ 1 :=
  domain_bound 1 (by norm_num) 0 (zero_mem (O := Bool) (E := ℂ) 1) _ _

example : (1 - (1 / 2 : ℝ)) • (0 : List Bool → Bool → ℝ) +
    (1 / 2 : ℝ) • ((1 : ℝ) • score (zeroParameters : Parameters Bool ℂ)) ∈ domain Bool ℂ 1 :=
  step_feasible 1 (1 / 2) 0 zeroParameters (zero_mem 1) zero_unit
    (by norm_num) (by norm_num)

end Transformer.Grokking.FlatSpectrum.ConvexChannel.LearnedRecurrent

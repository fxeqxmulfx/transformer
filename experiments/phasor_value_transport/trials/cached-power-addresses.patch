+struct TokenPowers {
+    powers: [usize; 3],
+    quotient_factor: usize,
+}
+
+impl TokenPowers {
+    fn new(x: usize, p: usize) -> Self {
+        let square = x * x % p;
+        Self {
+            powers: [x, square, square * x % p],
+            quotient_factor: power_factor(x, p),
+        }
+    }
+}

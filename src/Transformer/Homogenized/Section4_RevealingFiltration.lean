/-
# Homogenized Transformers — a noise filtration that reveals the token

`IsMcKeanVlasovSolution` takes its noise filtration `𝒢` as data, subject only to
`𝒢 ≤ ℱ`.  In `def:nonlinear_SDE_common` of arXiv:2604.01978v1 it is
`(ℱ_t^W)`, generated by a Wiener process `W` independent of `x_0`, and that is
what `McKeanVlasov.lean` cannot write.  So where the field vanishes a frozen
token solves the formal equation for *every* noise filtration, with `μ(t)` any
`𝒢`-adapted version of `Law(x_0 | 𝒢_t)` that starts at `Law(x_0)`
(`isMcKeanVlasovSolution_rest`).

`revealFiltration` knows nothing up to time `0` and everything after.  With it
`μ(t)` jumps from `Law(x_0)` to `δ_{x_0}` at `0+` while nothing moves
(`isMcKeanVlasovSolution_reveal`); under the trivial filtration the same token
is `isMcKeanVlasovSolution_frozen`.  `Section4_WellPosedRefutation` sets the
two side by side.

Source: arXiv:2604.01978v1, `def:nonlinear_SDE_common`.
-/

import Transformer.Homogenized.Frozen

open MeasureTheory

namespace Transformer
namespace Homogenized

variable {Ω : Type*} {m : MeasurableSpace Ω}

/-- The filtration that knows nothing up to time `0` and everything after. -/
noncomputable def revealFiltration (m : MeasurableSpace Ω) : Filtration ℝ m where
  seq t := if t ≤ 0 then ⊥ else m
  mono' s t hst := by
    by_cases ht : t ≤ 0
    · simp [ht, hst.trans ht]
    · simp only [ht, ite_false]
      split_ifs <;> simp
  le' t := by
    show (if t ≤ 0 then ⊥ else m) ≤ m
    split_ifs <;> simp

theorem revealFiltration_apply (t : ℝ) :
    revealFiltration m t = if t ≤ 0 then ⊥ else m :=
  rfl

/-- `Law(x₀ | revealFiltration)` for a token frozen at `x₀`: the law of `x₀` up
to time `0`, and `δ_{x₀}` after. -/
noncomputable def revealLaw {E : Type*} [MeasurableSpace E] (P : Measure Ω) (x₀ : Ω → E)
    (t : ℝ) (ω : Ω) : Measure E :=
  if t ≤ 0 then P.map x₀ else Measure.dirac (x₀ ω)

theorem revealLaw_of_nonpos {E : Type*} [MeasurableSpace E] (P : Measure Ω) (x₀ : Ω → E)
    {t : ℝ} (ht : t ≤ 0) : revealLaw P x₀ t = fun _ => P.map x₀ :=
  funext fun _ => ite_eq_left ht

theorem revealLaw_of_pos {E : Type*} [MeasurableSpace E] (P : Measure Ω) (x₀ : Ω → E)
    {t : ℝ} (ht : ¬ t ≤ 0) : revealLaw P x₀ t = fun ω => Measure.dirac (x₀ ω) :=
  funext fun _ => ite_eq_right ht

/-- **A frozen token solves `eq:non_linear_SDE_common` for every noise
filtration** whenever the field vanishes: for every `𝒢` and every
`𝒢`-adapted version `μ` of `Law(x₀ | 𝒢_t)` with `μ(0) = Law(x₀)`, every
compensated process is identically `0`, and nothing else ties `𝒢` to a noise. -/
theorem isMcKeanVlasovSolution_rest {d : ℕ} (β T : ℝ) (ρ : Measure (HeadParam d))
    (hG : HasVanishingField β ρ) (P : Measure Ω) [IsProbabilityMeasure P]
    (𝒢 : Filtration ℝ m) (x₀ : Ω → EucSpace d) (hx₀ : Measurable x₀)
    (hs : ∀ ω, ‖x₀ ω‖ = 1) (μ : ℝ → Ω → Measure (EucSpace d))
    (h0 : ∀ ω, μ 0 ω = P.map x₀) (hprob : ∀ t ω, IsProbabilityMeasure (μ t ω))
    (hadapt : ∀ t ∈ Set.Icc (0 : ℝ) T, Measurable[𝒢 t] (μ t))
    (hcond : ∀ t ∈ Set.Icc (0 : ℝ) T, ∀ A : Set (EucSpace d), MeasurableSet A →
      (fun ω => (μ t ω A).toReal)
        =ᵐ[P] condExp (𝒢 t) P (fun ω => Set.indicator A (1 : EucSpace d → ℝ) (x₀ ω))) :
    IsMcKeanVlasovSolution β T ρ P (Filtration.const ℝ m le_rfl) 𝒢 x₀ (P.map x₀)
      (fun _ => x₀) μ := by
  have hbr : ∀ (φ : EucSpace d → ℝ) (s : ℝ) (ω : Ω),
      ∫ θ, fderiv ℝ φ (x₀ ω) (GfieldOf β ρ (μ s ω) (x₀ ω) θ) ^ 2 ∂ρ = 0 := by
    intro φ s ω
    rw [show ∫ θ, fderiv ℝ φ (x₀ ω) (GfieldOf β ρ (μ s ω) (x₀ ω) θ) ^ 2 ∂ρ
        = ∫ _θ, (0 : ℝ) ∂ρ from integral_congr_ae ?_, integral_zero]
    filter_upwards [hG _ _ (hs ω)] with θ hθ
    rw [hθ, map_zero]
    ring
  have hmart : ∀ φ : EucSpace d → ℝ,
      mvMart β ρ (fun (_ : ℝ) => x₀) μ φ = fun _ _ => (0 : ℝ) := by
    intro φ; funext t ω
    simp [mvMart, mvGenerator_of_vanishing hG _ φ (hs ω)]
  refine ⟨fun t => 𝒢.le t, fun _ ω => hs ω, fun _ _ => hx₀.stronglyMeasurable, hadapt,
    Filter.Eventually.of_forall fun _ => rfl, rfl, h0, hprob, hcond, fun φ _ => ?_,
    fun φ _ => ?_⟩
  · rw [hmart φ]; exact isMartingaleOn_const T _ P 0
  · simp only [hmart φ, hbr φ]
    simpa using isMartingaleOn_const T (Filtration.const ℝ m le_rfl) P 0

/-- Given nothing, the conditional law of `x₀` is its law. -/
theorem condExp_bot_indicator {E : Type*} [MeasurableSpace E] (P : Measure Ω)
    [IsProbabilityMeasure P] {x₀ : Ω → E} (hx₀ : Measurable x₀) {A : Set E}
    (hA : MeasurableSet A) :
    condExp ⊥ P (fun ω => Set.indicator A (1 : E → ℝ) (x₀ ω))
      = fun _ => (P.map x₀ A).toReal := by
  rw [condExp_bot]
  funext _
  rw [← integral_map hx₀.aemeasurable (stronglyMeasurable_one.indicator hA).aestronglyMeasurable,
    integral_indicator_one hA, measureReal_def]

/-- **A frozen token under the revealing filtration** solves
`eq:non_linear_SDE_common` whenever the field vanishes, with
`μ(t) = δ_{x₀}` for `t > 0`: given everything, the conditional law of `x₀` is
the point mass at `x₀`. -/
theorem isMcKeanVlasovSolution_reveal {d : ℕ} (β T : ℝ) (ρ : Measure (HeadParam d))
    (hG : HasVanishingField β ρ) (P : Measure Ω) [IsProbabilityMeasure P]
    (x₀ : Ω → EucSpace d) (hx₀ : Measurable x₀) (hs : ∀ ω, ‖x₀ ω‖ = 1) :
    IsMcKeanVlasovSolution β T ρ P (Filtration.const ℝ m le_rfl) (revealFiltration m) x₀
      (P.map x₀) (fun _ => x₀) (revealLaw P x₀) := by
  refine isMcKeanVlasovSolution_rest β T ρ hG P _ x₀ hx₀ hs _
    (fun _ => by rw [revealLaw_of_nonpos P x₀ le_rfl]) (fun t ω => ?_) (fun t _ => ?_)
    fun t _ A hA => ?_
  · unfold revealLaw; split_ifs <;> infer_instance
  · rw [revealFiltration_apply]
    by_cases ht : t ≤ 0
    · rw [revealLaw_of_nonpos P x₀ ht]; exact measurable_const
    · rw [revealLaw_of_pos P x₀ ht, ite_eq_right ht]; exact Measure.measurable_dirac.comp hx₀
  · by_cases ht : t ≤ 0
    · rw [revealLaw_of_nonpos P x₀ ht, revealFiltration_apply, ite_eq_left ht,
        condExp_bot_indicator P hx₀ hA]
    · have hf : StronglyMeasurable (fun ω => Set.indicator A (1 : EucSpace d → ℝ) (x₀ ω)) :=
        (stronglyMeasurable_one.indicator hA).comp_measurable hx₀
      have hi : Integrable (fun ω => Set.indicator A (1 : EucSpace d → ℝ) (x₀ ω)) P := by
        refine Integrable.of_bound hf.aestronglyMeasurable 1 (Filter.Eventually.of_forall
          fun ω => ?_)
        by_cases h : x₀ ω ∈ A <;> simp [h]
      rw [revealLaw_of_pos P x₀ ht, revealFiltration_apply, ite_eq_right ht,
        condExp_of_stronglyMeasurable le_rfl hf hi]
      refine Filter.Eventually.of_forall fun ω => ?_
      simp only [Measure.dirac_apply' _ hA]
      by_cases h : x₀ ω ∈ A <;> simp [h]

/-- The hypotheses of `isMcKeanVlasovSolution_reveal` hold: the trivial head
law and a token frozen at `basePoint 0` on the one-point space.  Through it they
discharge those of `isMcKeanVlasovSolution_rest` and `condExp_bot_indicator`;
`0` and `1` satisfy those of `revealLaw_of_nonpos` and `revealLaw_of_pos`. -/
example : HasVanishingField 0 (Measure.dirac (0 : HeadParam 1)) ∧
    Measurable (fun _ : Unit => ((basePoint 0 : SSphere 1) : EucSpace 1)) ∧
    (∀ _ : Unit, ‖((basePoint 0 : SSphere 1) : EucSpace 1)‖ = 1) ∧
    (0 : ℝ) ≤ 0 ∧ ¬ (1 : ℝ) ≤ 0 :=
  ⟨hasVanishingField_dirac_zero 0, measurable_const,
    fun _ => by simp [basePoint, PiLp.norm_single], le_rfl, by norm_num⟩

end Homogenized
end Transformer

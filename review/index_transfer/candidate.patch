diff --git a/scripts/index_transfer_profile.py b/scripts/index_transfer_profile.py
new file mode 100644
index 00000000..84f77e29
--- /dev/null
+++ b/scripts/index_transfer_profile.py
@@ -0,0 +1,179 @@
+"""Task159: separate an index-upload wait from queued GPU work and compare exact updates.
+
+The per-batch control is CompiledStepper's input path at0f457bac. The candidate
+caches whole sampler tensors on the device; both use the same model, compiled
+graphs and Schedule-Free AdamW. All timings synchronize at their boundaries.
+No final test is evaluated. The active Basis cohort must be between chunks.
+"""
+
+import argparse
+import copy
+from datetime import datetime, timezone
+import hashlib
+import json
+from pathlib import Path
+import statistics
+import time
+import traceback
+
+import torch
+
+from lab.domain.spec import describe
+from lab.domain.training import rate
+from lab.infrastructure.benchmarks import build_task
+from lab.infrastructure.benchmarks.samplers import gather
+from lab.infrastructure.engine.indices import SamplerIndices
+from lab.infrastructure.engine.loop import Clock
+from lab.infrastructure.engine.residual import ResidualCompiledStepper
+from lab.infrastructure.loader import load
+from lab.infrastructure.nn import build_model
+from lab.infrastructure.provenance import provenance
+from lab.infrastructure.store import replace
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def cpu_tree(value):
+    if isinstance(value, torch.Tensor):
+        return value.detach().cpu().clone()
+    if isinstance(value, dict):
+        return {key: cpu_tree(part) for key, part in value.items()}
+    if isinstance(value, (list, tuple)):
+        return type(value)(cpu_tree(part) for part in value)
+    return copy.deepcopy(value)
+
+
+def upload_wait():
+    """Compare identical copies with and without queued dense matrix multiplies.
+
+    Event intervals include host enqueue gaps; they are not pure memcpy-kernel
+    timings. Separating the preceding compute interval prevents attributing all
+    blocking-call wall time to moving a few index bytes.
+    """
+    source = torch.arange(256)
+    generator = torch.Generator(device="cuda").manual_seed(159)
+    left = torch.randn(1024, 1024, device="cuda", generator=generator)
+    right = torch.randn(1024, 1024, device="cuda", generator=generator)
+    product = torch.empty_like(left)
+    for _ in range(5):
+        torch.mm(left, right, out=product)
+    torch.cuda.synchronize()
+    trials = []
+    for repeat in range(20):
+        for queued in ((False, True) if repeat % 2 == 0 else (True, False)):
+            torch.cuda.synchronize()
+            started, compute_done, copied = (torch.cuda.Event(enable_timing=True) for _ in range(3))
+            started.record()
+            if queued:
+                for _ in range(12):
+                    torch.mm(left, right, out=product)
+            compute_done.record()
+            before = time.perf_counter()
+            result = source.to("cuda")
+            wall_ms = (time.perf_counter() - before) * 1000
+            copied.record()
+            copied.synchronize()
+            torch.testing.assert_close(result.cpu(), source, rtol=0, atol=0)
+            trials.append({"queued": queued, "repeat": repeat, "upload_call_wall_ms": wall_ms,
+                           "preceding_gpu_interval_ms": started.elapsed_time(compute_done),
+                           "post_compute_gpu_interval_ms": compute_done.elapsed_time(copied)})
+    return {"index_bytes": source.numel() * source.element_size(), "trials": trials,
+            "interpretation": "CUDA event intervals include enqueue gaps; host upload-call time may include preceding queued work."}
+
+
+def training(spec, label, result):
+    result.update(label=label, experiment=describe(spec), trials=[])
+    task = build_task(spec.benchmark, spec.seeds.data, torch.device("cuda"))
+    model = build_model(spec.model, task.vocab, spec.seeds.model).cuda()
+    stepper = ResidualCompiledStepper(spec, task, model, Clock(torch.device("cuda")))
+    sampler = task.sampler(spec.budget.batch, spec.seeds.batch_seed)
+    start = time.monotonic()
+    stepper.prepare(sampler.sizes())
+    preparation_seconds = time.monotonic() - start
+    stepper.indices = gather
+
+    def updates(first, count):
+        for index in range(first, first + count):
+            parts, _ = sampler.next()
+            stepper.step(parts, rate(spec.optimizer.lr, spec.schedule, index), False)
+
+    updates(0, 100)
+    stepper.gradient_norms()
+    initial_model, initial_optimizer = cpu_tree(model.state_dict()), cpu_tree(stepper.state_dict())
+    initial_sampler = cpu_tree(sampler.state())
+    reference, trials = None, result["trials"]
+    for repeat in range(6):
+        order = ("per_batch", "cached") if repeat % 2 == 0 else ("cached", "per_batch")
+        for arm in order:
+            model.load_state_dict(initial_model)
+            stepper.load_state_dict(copy.deepcopy(initial_optimizer))
+            sampler.restore(initial_sampler)
+            stepper.indices = gather if arm == "per_batch" else SamplerIndices("cuda")
+            stepper.norms = []
+            updates(100, 20)
+            stepper.gradient_norms()
+            torch.cuda.synchronize()
+            torch.cuda.reset_peak_memory_stats()
+            started = time.perf_counter()
+            updates(120, 200)
+            torch.cuda.synchronize()
+            seconds = time.perf_counter() - started
+            norms = stepper.gradient_norms()
+            if len(norms) != 200 or not all(0 < value < float("inf") for value in norms):
+                raise ValueError("Every measured update must have a finite nonzero gradient")
+            final = {"model": cpu_tree(model.state_dict()), "optimizer": cpu_tree(stepper.state_dict()),
+                     "sampler": cpu_tree(sampler.state()), "gradients": norms}
+            if reference is None:
+                reference = final
+            else:
+                torch.testing.assert_close(reference, final, rtol=0, atol=0)
+            trials.append({"arm": arm, "repeat": repeat, "updates": 200, "seconds": seconds,
+                           "milliseconds_per_update": 1000 * seconds / 200,
+                           "peak_cuda_allocated_bytes": torch.cuda.max_memory_allocated(),
+                           "full_state_and_gradient_trace_exact": True})
+            print(label, arm, repeat, f"{1000 * seconds / 200:.4f}ms/update; exact state", flush=True)
+    medians = {arm: statistics.median(row["milliseconds_per_update"] for row in trials if row["arm"] == arm)
+               for arm in ("per_batch", "cached")}
+    torch.cuda.empty_cache()
+    result.update(preparation_seconds=preparation_seconds, median_ms_per_update=medians,
+                  cached_speedup=medians["per_batch"] / medians["cached"],
+                  scope="Warmed isolated throughput and exact320-update state; no generalization or final-test claim.")
+
+
+def run(output):
+    phase_path = ROOT / "experiments/basis_residual/runs/phase.json"
+    if phase_path.exists():
+        phase = json.loads(phase_path.read_text())
+        if phase["status"] not in ("awaiting_continuation", "learning_closed"):
+            raise RuntimeError("Wait for the active Basis GPU cohort to finish its chunk")
+    if not torch.cuda.is_available():
+        raise RuntimeError("This timing study requires an isolated CUDA device")
+    torch.set_num_threads(1)
+    result = {"started_utc": datetime.now(timezone.utc).isoformat(), "provenance": provenance("cuda"),
+              "source_sha256": hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
+              "reference_commit": "0f457bac", "training": [],
+              "promotion_rule": "Every exact-state check passes; median arithmetic speedup>=1.05 and median hard-recall speedup>=1.0 across six order-balanced repetitions."}
+    choices = (("modular-p97", "adaptive_residual", "canonical-p97-s11"),
+               ("basis-hard-recall", "basis_residual", "canonical-large-recall-s0"))
+    output.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        result["upload_wait"] = upload_wait()
+        for label, folder, key in choices:
+            spec = load(ROOT / "experiments" / folder).experiments[key]
+            record = {}
+            result["training"].append(record)
+            training(spec, label, record)
+            replace(output, json.dumps(result, indent=2, allow_nan=False) + "\n")
+        result["status"] = "complete"
+    except BaseException:
+        result.update(status="failed", traceback=traceback.format_exc())
+        raise
+    finally:
+        result["finished_utc"] = datetime.now(timezone.utc).isoformat()
+        replace(output, json.dumps(result, indent=2, allow_nan=False) + "\n")
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("output", type=Path)
+    run(parser.parse_args().output)

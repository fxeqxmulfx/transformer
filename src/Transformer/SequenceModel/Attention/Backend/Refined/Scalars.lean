@[expose] public section
noncomputable section
namespace Transformer.SequenceModel.Attention.Backend.Refined
open GPTMini Stability Execution Complete
open scoped BigOperators
set_option maxRecDepth 4096
set_option maxHeartbeats 2000000

/-- M3: auxiliary SDPA scores satisfy the actual scaled dot-product contract. -/
theorem local_scores (i j : Fin 2) :
    |raw_scores i j - inner ℝ (raw_query i) (raw_key j) / Real.sqrt (4 : ℝ)| ≤ (2 / 1000000000 : ℝ) := by
  fin_cases i <;> fin_cases j <;>
    norm_num [raw_scores, raw_query, raw_key, EuclideanSpace.inner_eq_star_dotProduct,
      dotProduct, Fin.sum_univ_succ]

/-- M3: the final raw tied matrix product is checked independently. -/
theorem local_logits (i : Fin 2) (v : Fin 3) :
    |raw_logits i v - inner ℝ (raw_normalized i) (weights.embedding v)| ≤ (0 : ℝ) := by
  fin_cases i <;> fin_cases v <;>
    norm_num [raw_logits, raw_normalized, weights, EuclideanSpace.inner_eq_star_dotProduct,
      dotProduct, Fin.sum_univ_succ]

/-- M3: both stored source positions have certified independent cosine/sine errors. -/
theorem local_tables (i : Fin 2) (c : Fin 2) :
    |raw_cos i c - Real.cos (angles 0 i c)| ≤ 1 / 10000000 ∧
    |raw_sin i c - Real.sin (angles 0 i c)| ≤ 1 / 10000000 := by
  fin_cases i
  · fin_cases c <;> norm_num [raw_cos, raw_sin, angles, sourceAngles]
  · have h := rope_local (raw_cos 1) (raw_sin 1)
      (by intro k; fin_cases k <;> norm_num [raw_cos, rotationPolynomial,
        Finset.sum_range_succ, pow_succ, Complex.mul_re, Complex.mul_im])
      (by intro k; fin_cases k <;> norm_num [raw_sin, rotationPolynomial,
        Finset.sum_range_succ, pow_succ, Complex.mul_re, Complex.mul_im]) c
    simpa [angles, sourceAngles, cfg, Config.head_dim] using h

end Transformer.SequenceModel.Attention.Backend.Refined

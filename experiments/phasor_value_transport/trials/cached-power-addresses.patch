+// Compare every base-table word with independent modular exponentiation,
+// including unit, composite and prime vocabularies and both wrap branches.
+pub fn check_power_addresses() -> Result<()> {
+    for p in [1_usize, 2, 3, 8, 17, 36, 97, 100, 193] {
+        let cache: Vec<_> = (0..p).map(|x| TokenPowers::new(x, p)).collect();
+        for a in 0..p {
+            for b in 0..p {
+                let power =
+                    |x: usize, n| crate::arithmetic_data::power(x as u32, n, p as u32) as usize;
+                let inverse = if b == 0 { 0 } else { power(b, p as u32 - 2) };
+                let sums =
+                    (1..=3).flat_map(|i| (1..=3).map(move |j| (power(a, i) + power(b, j)) % p));
+                let products =
+                    (1..=2).flat_map(|i| (1..=2).map(move |j| power(a, i) * power(b, j) % p));
+                let want = [b, (a + p - b) % p, a.abs_diff(b), a * inverse % p]
+                    .into_iter()
+                    .chain(sums)
+                    .chain(products)
+                    .enumerate()
+                    .map(|(table, value)| (table * p + value) as u32);
+                if addresses(&cache[a], &cache[b], p).into_iter().ne(want) {
+                    return Err(
+                        "cached Phasor address differs from the direct modular formula".into(),
+                    );
+                }
+            }
+        }
+    }
+    Ok(())
+}

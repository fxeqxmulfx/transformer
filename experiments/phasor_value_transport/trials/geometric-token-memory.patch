@@ -0,0 +1,82 @@
+//! One value scan per sequence and coordinate. The token table gather supplies
+//! the immediate term. The reverse scan supplies its full adjoint to the same
+//! deterministic token incidence lists used by the other learned tables.
+#[kernite_macros::kernels]
+pub mod kernels {
+    fn retention(r: f32, col: u32) {
+        let bits: u32;
+        let flag: pred;
+        and.b32(bits, col, 1);
+        setp.ne.u32(flag, bits, 0);
+        selp.f32(r, 0.5, 1.0, flag);
+        and.b32(bits, col, 2);
+        setp.ne.u32(flag, bits, 0);
+        if flag {
+            neg.f32(r, r);
+        }
+    }
+    pub unsafe extern "ptx-kernel" fn add_history(
+        hidden: *mut f32,
+        table: *const f32,
+        tokens: *const u32,
+        width: u32,
+        length: u32,
+    ) {
+        let (sequence, row, end, col, at, token): (u32, u32, u32, u32, u32, u32);
+        mov.u32(sequence, ctaid.x);
+        mov.u32(col, tid.x);
+        mul.lo.u32(row, sequence, length);
+        add.u32(end, row, length);
+        let (r, state, x): (f32, f32, f32);
+        retention(r, col);
+        mov.f32(state, 0.0);
+        let ptr: u64;
+        let more: pred;
+        label(position);
+        mad.lo.u32(at, row, width, col);
+        mad.wide.u32(ptr, at, 4, hidden);
+        ld.global.f32(x, [ptr]);
+        fma.rn.f32(x, r, state, x);
+        st.global.f32([ptr], x);
+        mad.wide.u32(ptr, row, 4, tokens);
+        ld.global.u32(token, [ptr]);
+        mad.lo.u32(at, token, width, col);
+        mad.wide.u32(ptr, at, 4, table);
+        ld.global.f32(x, [ptr]);
+        fma.rn.f32(state, r, state, x);
+        add.u32(row, row, 1);
+        setp.lt.u32(more, row, end);
+        if more {
+            bra(position);
+        }
+    }
+    pub unsafe extern "ptx-kernel" fn reverse(
+        out: *mut f32,
+        upstream: *const f32,
+        width: u32,
+        length: u32,
+    ) {
+        let (sequence, start, row, col, at): (u32, u32, u32, u32, u32);
+        mov.u32(sequence, ctaid.x);
+        mov.u32(col, tid.x);
+        mul.lo.u32(start, sequence, length);
+        add.u32(row, start, length);
+        let (r, tail, x): (f32, f32, f32);
+        retention(r, col);
+        mov.f32(tail, 0.0);
+        let ptr: u64;
+        let more: pred;
+        label(position);
+        sub.u32(row, row, 1);
+        mad.lo.u32(at, row, width, col);
+        mad.wide.u32(ptr, at, 4, upstream);
+        ld.global.f32(x, [ptr]);
+        fma.rn.f32(tail, r, tail, x);
+        mad.wide.u32(ptr, at, 4, out);
+        st.global.f32([ptr], tail);
+        setp.gt.u32(more, row, start);
+        if more {
+            bra(position);
+        }
+    }
+}

  "live_state_verification": {
    "program_source": "\"\"\"Verify step-5 attention observations on the actual mod-193 CUDA model and data.\n\nRun after the chosen repair and AttentionDiagnostics are declared in\nexperiments/mod193_stability. The shortened budget is only a live-state\ncheck; it supplies no generalization or repair evidence.\n\"\"\"\n\nfrom pathlib import Path\nimport runpy\nimport sys\nimport tempfile\nfrom unittest.mock import patch\n\nimport torch\n\nfrom lab.domain.spec import describe, swap\nfrom lab.domain.training import AttentionDiagnostics, Checkpoint\nfrom lab.infrastructure.engine.attention import AttentionObserver\nfrom lab.infrastructure.engine.eager import EagerStepper\nfrom lab.infrastructure.engine.loop import Training\nfrom lab.infrastructure.store import RunDirectory\n\nsys.path.insert(0, '/home/misha/lean_projects/transformer/python/tests')\nfrom test_graphs import summary\n\n\nROOT = Path('/home/misha/lean_projects/transformer')\nexperiments = runpy.run_path(str(ROOT / 'experiments/mod193_stability/experiment.py'))['experiments']\ncandidate = sys.argv[1]\nassert candidate in ('qknorm-one', 'scaleddot')\nfor label in ('base', 'sparsemax', f'repair-{candidate}'):\n    run = experiments[label]\n    assert isinstance(run.diagnostics, AttentionDiagnostics)\n    assert run.diagnostics.examples == 256 and run.execution.device.startswith('cuda')\n    run = swap(swap(swap(run, 'budget.updates', 20), 'evaluate.every', 10),\n               'diagnostics', AttentionDiagnostics(every=10, examples=256))\n    run = swap(run, 'checkpoint', Checkpoint(every=10))\n    original = AttentionObserver.observe\n    steps = []\n\n    def snapshot(training, observer, model):\n        return summary({'model': model.state_dict(), 'buffers': list(model.named_buffers()),\n                        'gradients': [parameter.grad for parameter in model.parameters()],\n                        'optimizer': training.stepper.state_dict(), 'sampler': training.sampler.state(),\n                        'CPU_rng': torch.get_rng_state(), 'CUDA_rng': torch.cuda.get_rng_state_all(),\n                        'modes': [module.training for module in model.modules()],\n                        'hooks': [list(module._forward_pre_hooks) for module in model.modules()],\n                        'fixed_batch': observer.fixed.batch, 'inputs': training.task.splits})\n\n    def checked(observer, model, task, step):\n        before = snapshot(training, observer, model)\n        record = original(observer, model, task, step)\n        assert before == snapshot(training, observer, model), f'{label} changed at step {step}'\n        assert record['examples'] == 256 and record['supervised_tokens'] == 512\n        assert record['split'] == 'heldout' and len(record['layers']) == 2\n        assert len(record['queries']) == 0\n        steps.append(step)\n        return record\n\n    with tempfile.TemporaryDirectory() as root:\n        directory = RunDirectory(root)\n        directory.begin(describe(run), {'engine': {}}, '# Read-only mod-193 live-state check\\n')\n        training = Training(run, directory, lambda record: None, EagerStepper)\n        with patch.object(AttentionObserver, 'observe', checked):\n            training()\n        assert steps == [0, 10, 20]\n        assert directory.checkpoint('cpu') is not None\n    print(f'{label}: all three actual-shape CUDA observations preserve live state exactly', flush=True)\n",

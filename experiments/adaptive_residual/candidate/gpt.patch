index 0000000..df8753c
--- /dev/null
+++ b/tests/diff_gpt/domain/model/test_conditional_gain.py
@@ -0,0 +1,188 @@
+"""Preserve initialization and recover conditional amplitude in the real block."""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import math
+from pathlib import Path
+from typing import TYPE_CHECKING
+
+import pytest
+import torch
+from torch import nn
+
+from diff_gpt.domain.model.block import Block
+from diff_gpt.domain.model.gpt import GPT
+from diff_gpt.domain.model.rope import rope_tables
+from diff_gpt.domain.optimizer.schedule_free import ScheduleFreeAdamW
+from tests.refgpt_df1e9f7.gpt import GPT as FrozenGPT
+
+if TYPE_CHECKING:
+    from diff_gpt.domain.model.kv_cache import KVCache
+
+
+def test_frozen_source_reference_hashes() -> None:
+    """The baseline must come from the recorded old source, not today's model."""
+    root = Path(__file__).resolve().parents[3] / "refgpt_df1e9f7"
+    manifest = json.loads((root / "manifest.json").read_text())
+    assert manifest["commit"].startswith("df1e9f7")
+    for name, entry in manifest["files"].items():
+        local = (root / name).read_bytes()
+        assert hashlib.sha256(local).hexdigest() == entry["local_sha256"]
+        original = local.replace(
+            b"from tests.refgpt_df1e9f7.", b"from diff_gpt.domain.model."
+        )
+        if name == "gpt.py":
+            # Undo the recorded type-only import sort as well as redirection.
+            original = original.replace(
+                b"    from diff_gpt.domain.sampler.sampler import Sampler\n"
+                b"    from diff_gpt.domain.model.kv_cache import KVCache\n",
+                b"    from diff_gpt.domain.model.kv_cache import KVCache\n"
+                b"    from diff_gpt.domain.sampler.sampler import Sampler\n",
+            )
+        assert hashlib.sha256(original).hexdigest() == entry["source_sha256"]
+
+
+@pytest.mark.parametrize("seed", [11, 17])
+def test_zero_rows_preserve_source_rng_logits_and_common_gradients(seed: int) -> None:
+    """Adding the amplitude path must not improve a comparison by changing its start."""
+    torch.set_num_threads(1)
+    torch.manual_seed(seed)
+    expected = FrozenGPT(97, 128, 33, 4, 4, use_checkpoint=False, pad_vocab_size_to=1)
+    rng = torch.get_rng_state()
+    torch.manual_seed(seed)
+    actual = GPT(97, 128, 33, 4, 4, use_checkpoint=False, pad_vocab_size_to=1)
+    assert torch.equal(rng, torch.get_rng_state())
+    common = dict(expected.named_parameters())
+    extra = []
+    for name, parameter in actual.named_parameters():
+        if name in common:
+            torch.testing.assert_close(parameter, common[name], rtol=0, atol=0)
+        else:
+            assert name.endswith("_gain.weight")
+            assert torch.count_nonzero(parameter) == 0
+            extra.append(parameter)
+    assert sum(p.numel() for p in extra) == 2 * actual.n_layer * actual.n_embd
+    tokens = torch.tensor([[1, 2], [1, 1], [12, 33], [94, 96]])
+    a, b = actual(tokens)[0], expected(tokens)[0]
+    torch.testing.assert_close(a, b, rtol=0, atol=0)
+    a.square().mean().backward()
+    b.square().mean().backward()
+    for name, parameter in actual.named_parameters():
+        assert parameter.grad is not None
+        if name in common:
+            torch.testing.assert_close(
+                parameter.grad, common[name].grad, rtol=0, atol=0
+            )
+        else:
+            assert parameter.grad.norm() > 0
+
+
+class ZeroAttention(nn.Module):
+    """Fixed zero attention isolates the block's feed-forward amplitude path."""
+
+    def forward(
+        self,
+        value: torch.Tensor,
+        cos: torch.Tensor,
+        sin: torch.Tensor,
+        kv_cache: KVCache | None,
+    ) -> torch.Tensor:
+        """Return a zero context branch under the fixture's no-cache contract."""
+        assert kv_cache is None
+        assert cos.shape == sin.shape
+        return torch.zeros_like(value)
+
+
+class FixedBranch(nn.Module):
+    """A supplied unit-RMS direction gives both placements a finite exact optimum."""
+
+    def forward(self, value: torch.Tensor) -> torch.Tensor:
+        """Return the fixed unit-RMS feature in the input layout."""
+        return torch.ones_like(value)
+
+
+class BeforeRMSControl(Block):
+    """Broken control: move the same gain before the output RMS normalization."""
+
+    def forward(
+        self,
+        value: torch.Tensor,
+        cos: torch.Tensor,
+        sin: torch.Tensor,
+        kv_cache: KVCache | None,
+    ) -> torch.Tensor:
+        """Evaluate the alternative placement for the same fixed branch."""
+        assert kv_cache is None
+        assert cos.shape == sin.shape
+        normalized = self.ln_2(value)
+        branch = self.ffn_out_norm(self.ffn_gain(normalized) * self.ffwd(normalized))
+        return value + self.residual_scale * branch
+
+
+def block(kind: type[Block]) -> Block:
+    """Freeze every degree of freedom except the production branch gain row."""
+    result = kind(2, 1, 0, n_layer=1)
+    result.sa = ZeroAttention()
+    result.ffwd = FixedBranch()
+    result.requires_grad_(requires_grad=False)
+    result.ffn_gain.weight.requires_grad_(requires_grad=True)
+    return result
+
+
+def test_block_learns_conditional_gain_and_rejects_pre_rms_control() -> None:
+    """Equal representability and starts; only the normalized gradient path differs."""
+    torch.set_num_threads(1)
+    gain_limit, solved_mse, stalled_mse = 2.0, 1e-8, 1e-3
+    inputs = torch.tensor([[[1.0, -1.0]], [[1.0, 1.0]]])
+    coefficients = torch.tensor([0.25, 0.75])[:, None, None]
+    cos, sin = rope_tables(2, 1)
+    eps = torch.finfo(torch.float32).eps
+    amplitude = 1 / math.sqrt(1 + eps)
+    starts, errors = [], []
+    for kind in (Block, BeforeRMSControl):
+        model = block(kind)
+        target = inputs + model.residual_scale * coefficients * torch.ones_like(inputs)
+        starts.append(model(inputs, cos, sin, None).detach())
+        # Solve both conditional logits analytically, accounting for input RMS.
+        gains = [
+            math.sqrt(eps) * c / math.sqrt(1 - c * c)
+            if kind is BeforeRMSControl
+            else c / amplitude
+            for c in (0.25, 0.75)
+        ]
+        assert all(0 < gain < gain_limit for gain in gains)
+        negative, positive = [math.log(gain / (2 - gain)) for gain in gains]
+        with torch.no_grad():
+            model.ffn_gain.weight.copy_(
+                torch.tensor(
+                    [
+                        [
+                            (negative + positive) / (2 * amplitude),
+                            (positive - negative) / (2 * amplitude),
+                        ]
+                    ]
+                )
+            )
+        torch.testing.assert_close(
+            model(inputs, cos, sin, None), target, rtol=1e-6, atol=1e-6
+        )
+        with torch.no_grad():
+            model.ffn_gain.weight.zero_()
+        optimizer = ScheduleFreeAdamW(
+            [model.ffn_gain.weight], lr=0.01, betas=(0.9, 0.98), weight_decay=0
+        )
+        for _ in range(3000):
+            optimizer.zero_grad(set_to_none=True)
+            loss = (model(inputs, cos, sin, None) - target).square().mean()
+            loss.backward()
+            optimizer.step()
+        optimizer.eval()
+        with torch.no_grad():
+            errors.append(
+                (model(inputs, cos, sin, None) - target).square().mean().item()
+            )
+    torch.testing.assert_close(starts[0], starts[1], rtol=0, atol=0)
+    assert errors[0] < solved_mse
+    assert errors[1] > stalled_mse

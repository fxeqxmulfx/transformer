  "program_source": "\"\"\"Check the complete small reduction and reproduce the original softmax controls.\"\"\"\n\nimport hashlib\nimport json\nfrom pathlib import Path\n\nimport torch\n\n\nROOT = Path('/tmp/transformer-qknorm-study')\nEXPERIMENT = ROOT / 'experiments/basis_qknorm'\nORIGINAL = Path('/home/misha/lean_projects/transformer/experiments/basis_sparsemax')\nOUTPUT = EXPERIMENT / 'small_control_repetition.json'\n\n\ndef sha(path):\n    with path.open('rb') as source:\n        return hashlib.file_digest(source, 'sha256').hexdigest()\n\n\ndef equal(left, right):\n    if isinstance(left, torch.Tensor):\n        assert isinstance(right, torch.Tensor)\n        return left.dtype == right.dtype and left.shape == right.shape and torch.equal(left, right)\n    if isinstance(left, dict):\n        return isinstance(right, dict) and left.keys() == right.keys() and all(equal(value, right[key]) for key, value in left.items())\n    if isinstance(left, (list, tuple)):\n        return type(left) is type(right) and len(left) == len(right) and all(equal(a, b) for a, b in zip(left, right))\n    return type(left) is type(right) and left == right\n\n\ndef main():\n    artifact = json.loads((EXPERIMENT / 'small_results.json').read_text())\n    assert len(artifact['runs']) == 45\n    assert hashlib.sha256(artifact['program_source'].encode()).hexdigest() == artifact['program_sha256']\n    assert hashlib.sha256(artifact['helper_source'].encode()).hexdigest() == artifact['helper_sha256']\n    assert sha(EXPERIMENT / 'experiment.py') == artifact['experiment_source_sha256']\n    assert sha(EXPERIMENT / 'preparation.json') == artifact['preparation_sha256']\n    assert all(sha(ROOT / 'python/src/lab' / path) == digest\n               for path, digest in artifact['runtime_code_sha256'].items())\n    hashes, repetitions, observations = {}, {}, 0\n    for label, run in artifact['runs'].items():\n        directory = EXPERIMENT / 'runs' / label\n        assert all(sha(EXPERIMENT / path) == digest for path, digest in run['source'].items()), label\n        hashes[label] = sha(directory / 'checkpoint.pt')\n        heads = [head for layer in run['final_heads'].values() for head in layer['actual']['nontrivial_rows']]\n        assert len(heads) == 8 and all(head['row_count'] > 0 for head in heads), label\n        if run['arm'] != 'softmax':\n            assert all(head['exact_zero_pair_share'] > 0 for head in heads), label\n            continue\n        original = ORIGINAL / 'runs' / label\n        histories = [[json.loads(line) for line in (path / 'history.jsonl').read_text().splitlines()]\n                     for path in (directory, original)]\n        ignored = {'training_seconds', 'wall_seconds'}\n        measured = [[{key: value for key, value in row.items() if key not in ignored} for row in history]\n                    for history in histories]\n        assert measured[0] == measured[1], label\n        observations += len(measured[0])\n        checkpoints = [torch.load(path / 'checkpoint.pt', map_location='cpu', weights_only=True)\n                       for path in (directory, original)]\n        omitted = {'training_seconds', 'diagnostic_seconds', 'wall_seconds', 'attention'}\n        selected = [{key: value for key, value in checkpoint.items() if key not in omitted}\n                    for checkpoint in checkpoints]\n        assert equal(selected[0], selected[1]), label\n        repetitions[label] = {\n            'canonical_observations': len(measured[0]), 'differing_observations': 0,\n            'checkpoint_fields_compared': sorted(selected[0]),\n            'checkpoint_tensors_and_values_exact': True,\n            'history_sha256': {'current': sha(directory / 'history.jsonl'), 'original': sha(original / 'history.jsonl')},\n            'checkpoint_sha256': {'current': hashes[label], 'original': sha(original / 'checkpoint.pt')},\n        }\n    assert len(repetitions) == 15\n    program = Path(__file__).read_text()\n    result = {\n        'scope': 'Complete 45-run small reduction and 15 contemporary softmax controls compared to step 1',\n        'raw_file_hashes_verified': sum(len(run['source']) for run in artifact['runs'].values()),\n        'small_results_sha256': sha(EXPERIMENT / 'small_results.json'),\n        'runtime_source_files_verified': len(artifact['runtime_code_sha256']),\n        'checkpoint_sha256': hashes, 'softmax_runs_compared': len(repetitions),\n        'canonical_observations_compared': observations, 'differing_observations': 0,\n        'history_fields_excluded': sorted(ignored), 'checkpoint_fields_excluded': sorted(omitted),\n        'softmax_repetitions': repetitions,\n        'program_source': program, 'program_sha256': hashlib.sha256(program.encode()).hexdigest(),\n    }\n    OUTPUT.write_text(json.dumps(result, indent=2) + '\\n')\n    print(json.dumps({key: result[key] for key in ('raw_file_hashes_verified', 'runtime_source_files_verified',\n        'softmax_runs_compared', 'canonical_observations_compared', 'differing_observations')}))\n\n\nif __name__ == '__main__':\n    main()\n",
  "program_sha256": "5249be6c4ee2b6247cae69505000ee15a0944d379c642e34c7b4aa28c157d4ef"

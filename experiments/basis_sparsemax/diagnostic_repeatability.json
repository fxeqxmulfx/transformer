{
  "question": "Does the two-thread large-model drift occur without diagnostics?",
  "scope": "Three independent twenty-update compiled large depth/sparsemax runs; no causal attribution to a particular kernel",
  "source_program": {
    "path": "/tmp/diagnose_basis_diagnostics.py",
    "sha256": "a647636594e95008c70dd018c5984c7d7a4a318fc155544fbd58099ecba9ea4b",
    "source": "\"\"\"Compare repeatability with the effect of sampling, without changing lab code.\"\"\"\n\nfrom pathlib import Path\nimport json\nimport sys\n\nimport torch\n\nsys.path.insert(0, \"tests\")\nfrom test_sparsemax_compiled import diagnostic_cases\nfrom test_graphs import train, summary\nfrom test_engine import untimed\nfrom lab.domain.model import Softmax, Sparsemax\nfrom lab.domain.spec import substitute, swap\nfrom lab.domain.training import Diagnostics\nfrom lab.infrastructure.engine.compiled import CompiledStepper\nfrom lab.infrastructure.store import RunDirectory\n\n\ndef differences(left, right, path=\"\"):\n    if torch.is_tensor(left):\n        if not torch.equal(left, right):\n            delta = (left.to(torch.float64) - right.to(torch.float64)).abs()\n            yield {\"path\": path, \"maximum_absolute_difference\": delta.max().item(),\n                   \"different_entries\": torch.count_nonzero(delta).item(), \"entries\": left.numel()}\n    elif isinstance(left, dict):\n        for key in left:\n            if key not in (\"training_seconds\", \"diagnostic_seconds\", \"wall_seconds\"):\n                yield from differences(left[key], right[key], f\"{path}.{key}\")\n    elif isinstance(left, (tuple, list)):\n        for index, (a, b) in enumerate(zip(left, right, strict=True)):\n            yield from differences(a, b, f\"{path}.{index}\")\n    elif left != right:\n        yield {\"path\": path, \"left\": left, \"right\": right}\n\n\ntask = sys.argv[1]\nweights = Softmax() if sys.argv[2] == \"softmax\" else Sparsemax()\nbase = substitute(diagnostic_cases()[task], Softmax, weights)\nroot = Path(sys.argv[3])\nfor name in (\"plain-a\", \"plain-b\", \"sampled\"):\n    run = swap(base, \"diagnostics\", Diagnostics(every=10)) if name == \"sampled\" else base\n    print(\"training\", task, type(weights).__name__, name, flush=True)\n    train(run, root / name, CompiledStepper)\n\na, b, sampled = (RunDirectory(root / name) for name in (\"plain-a\", \"plain-b\", \"sampled\"))\nfor name, other in ((\"plain-repeat\", b), (\"diagnostics\", sampled)):\n    checkpoints = list(differences(a.checkpoint(\"cpu\"), other.checkpoint(\"cpu\")))\n    history = list(differences(untimed(a.records(\"history\")), untimed(other.records(\"history\"))))\n    report = {\"comparison\": name, \"checkpoint_differences\": len(checkpoints),\n              \"first_checkpoint_differences\": checkpoints[:12], \"history_differences\": len(history),\n              \"first_history_differences\": history[:12]}\n    print(json.dumps(report), flush=True)\n"
  },

module

public import Transformer.Grokking.FlatSpectrum.CoupledMoments.ModularCoding.Normalization

/-!
# The observed joint module over a composite domain

Source: `review/flat_spectrum.md`, CM28. Rows, columns and classes remain
categorical names. The joint module contains the actual observed additive
equations and two shift gauges. It never pins an unobserved axis arbitrarily.

Being generated by one vector is an observable algebraic condition on this
module, not a hypothesis supplying the unknown code. Over a composite ring,
nonzero scalars need not be units. The scalar comparison below instead uses
an actual coordinate equal to one, supplied later by a bijective class code.
-/

@[expose] public section

namespace Transformer.Grokking.FlatSpectrum.CoupledMoments.CompositeDiscovery

variable {R : Type*} [CommRing R] {V n C S : Type*}

/-- A module is generated by one of its vectors, CM28. Zero modules are
allowed here; realizability by a bijective code rules them out when needed. -/
def Cyclic (K : Submodule R (V → R)) : Prop :=
  ∃ g ∈ K, ∀ x ∈ K, ∃ a : R, x = a • g

/-- A cyclic module containing a vector with a coordinate equal to one is
generated by that vector, even over a composite ring, CM28. -/
theorem scalar_of_cyclic {K : Submodule R (V → R)} (hK : Cyclic K)
    {x y : V → R} (hx : x ∈ K) (hy : y ∈ K) (h1 : ∃ v, x v = 1) :
    ∃ a : R, y = a • x := by
  obtain ⟨g, _, hg⟩ := hK
  obtain ⟨a, ha⟩ := hg x hx
  obtain ⟨b, hb⟩ := hg y hy
  obtain ⟨v, hv⟩ := h1
  have hu : a * g v = 1 := by
    have he := congrFun ha v
    simpa only [hv, Pi.smul_apply, smul_eq_mul] using he.symm
  refine ⟨b * g v, ?_⟩
  funext j
  rw [ha, hb]
  simp only [Pi.smul_apply, smul_eq_mul]
  calc
    b * g j = (b * g j) * (a * g v) := by rw [hu, mul_one]
    _ = (b * g v) * (a * g j) := by ring

/-- An actual normalized vector and a trivial anchored kernel certify that
the whole module is cyclic, CM28. The last condition is checked by elimination
of the original homogeneous matrix plus one coordinate row. -/
theorem cyclic_of_anchored_kernel {K : Submodule R (V → R)} {g : V → R} {v : V}
    (hg : g ∈ K) (h1 : g v = 1)
    (hz : ∀ x ∈ K, x v = 0 → x = 0) : Cyclic K := by
  refine ⟨g, hg, fun x hx => ⟨x v, ?_⟩⟩
  have hm := K.sub_mem hx (K.smul_mem (x v) hg)
  have he : x - x v • g = 0 := hz _ hm (by simp [h1])
  funext j
  have hj := congrFun he j
  simp only [Pi.sub_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hj ⊢
  linear_combination hj

/-- Pack named row, column and class coordinates into one vector, CM28. -/
def pack (r s : n → R) (z : C → R) : n ⊕ (n ⊕ C) → R :=
  Sum.elim r (Sum.elim s z)

/-- The actual joint training equations and two harmless shift gauges, CM28.
Every row and column remains a variable, including unobserved ones. -/
def jointKernel (R : Type*) [CommRing R] (cell : S → n × n) (labels : S → C)
    (i₀ : n) (c₀ : C) : Submodule R (n ⊕ (n ⊕ C) → R) where
  carrier := {x | (∀ t, x (.inl (cell t).1) + x (.inr (.inl (cell t).2)) =
      x (.inr (.inr (labels t)))) ∧ x (.inl i₀) = 0 ∧ x (.inr (.inr c₀)) = 0}
  add_mem' := by
    rintro x y ⟨hx, hi, hc⟩ ⟨hy, hj, hd⟩
    refine ⟨fun t => ?_, ?_, ?_⟩
    · simp only [Pi.add_apply]
      linear_combination hx t + hy t
    · simp [hi, hj]
    · simp [hc, hd]
  zero_mem' := by simp
  smul_mem' := by
    rintro a x ⟨hx, hi, hc⟩
    refine ⟨fun t => ?_, ?_, ?_⟩
    · simp only [Pi.smul_apply, smul_eq_mul]
      linear_combination a * hx t
    · simp [hi]
    · simp [hc]

/-- Shift a fitted code and phases to the two observed gauges, CM28. No
scaling or inverse of a possibly nonunit residue is used. -/
def gaugeVector (e : C → R) (r s : n → R) (i₀ : n) (c₀ : C) :
    n ⊕ (n ⊕ C) → R :=
  pack (fun i => r i - r i₀) (fun j => s j + r i₀ - e c₀)
    (fun c => e c - e c₀)

/-- Every actual training fit has a vector in the observed joint module,
CM28. Repeated row or column phases are permitted. -/
theorem gaugeVector_mem {cell : S → n × n} {labels : S → C}
    (e : C → R) (r s : n → R) (i₀ : n) (c₀ : C)
    (hfit : ∀ t, e (labels t) = r (cell t).1 + s (cell t).2) :
    gaugeVector e r s i₀ c₀ ∈ jointKernel R cell labels i₀ c₀ := by
  refine ⟨fun t => ?_, ?_, ?_⟩
  · change (r (cell t).1 - r i₀) + (s (cell t).2 + r i₀ - e c₀) =
      e (labels t) - e c₀
    linear_combination -hfit t
  · change r i₀ - r i₀ = 0
    ring
  · change e c₀ - e c₀ = 0
    ring

/-- Bijective class codes supply a coordinate equal to one, CM28. This is
the step that replaces the invalid composite-ring nonzero-scalar argument. -/
theorem gaugeVector_one (e : C ≃ R) (r s : n → R) (i₀ : n) (c₀ : C) :
    ∃ v, gaugeVector e r s i₀ c₀ v = 1 := by
  refine ⟨.inr (.inr (e.symm (1 + e c₀))), ?_⟩
  change e (e.symm (1 + e c₀)) - e c₀ = 1
  rw [e.apply_symm_apply]
  ring

/-! A composite-ring witness for the algebraic certificate. The nonconstant
table with genuinely held-out cells is supplied in `Witness`. -/

example : Cyclic (⊤ : Submodule (ZMod 6) (Unit → ZMod 6)) := by
  apply cyclic_of_anchored_kernel (K := (⊤ : Submodule (ZMod 6) (Unit → ZMod 6)))
    (g := fun _ => 1) (v := ()) (by simp) rfl
  intro x _ hx
  funext j
  cases j
  exact hx

example : ∃ a : ZMod 6, (fun _ : Unit => 5) = a • (fun _ => 1) := by
  apply scalar_of_cyclic (K := ⊤) ?_ (by simp) (by simp) ⟨(), rfl⟩
  exact ⟨fun _ => 1, by simp, fun x _ => ⟨x (), by ext j; cases j; simp⟩⟩

example : gaugeVector (Equiv.refl (ZMod 6)) (fun i => i) (fun j => j) 0 0 ∈
    jointKernel (ZMod 6) (fun x : ZMod 6 × ZMod 6 => x) (fun x => x.1 + x.2) 0 0 :=
  gaugeVector_mem _ _ _ _ _ (fun _ => rfl)

example : ∃ v, gaugeVector (Equiv.refl (ZMod 6)) (fun i => i) (fun j => j) 0 0 v = 1 :=
  gaugeVector_one _ _ _ _ _

end Transformer.Grokking.FlatSpectrum.CoupledMoments.CompositeDiscovery

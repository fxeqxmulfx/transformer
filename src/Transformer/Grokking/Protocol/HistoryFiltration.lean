module

public import Transformer.Grokking.Protocol.ShuffleHistory
public import Mathlib.Probability.Kernel.CondDistrib
public import Mathlib.Probability.Martingale.Convergence

/-!
# Given its history a run goes on with fresh shuffles: conditional probabilities and their limit

Source: openai/grok at 3d64b1d8, `grok/data.py` (`ArithmeticIterator`: a new permutation for
each epoch); `experiments/grok_division/PROTOCOL.md`, *Randomness*. The paper,
arXiv:2201.02177v1 (Power et al.), states no probability. The limit is Lévy's zero-one law
(P. Lévy, *Théorie de l'addition des variables aléatoires*, 1937), here from Mathlib's
martingale convergence theorem `MeasureTheory.Integrable.tendsto_ae_condExp`.

The histories of a sample through the epochs (`ShuffleHistory`) form a filtration
(`historyFiltration`) that generates every event of the sample (`le_iSup_historyFiltration`).
Given the history through epoch `e`, the later shuffles have their own law
(`condDistrib_laterShuffles`), so the conditional expectation of a function of the sample is
its mean over the samples resumed with fresh shuffles (`condExp_history`). Hence, for an event
`G` of the sample:

* the probability of `G` is the mean, over the samples, of the probability that the sample
  resumed after epoch `e` with fresh shuffles is in `G` (`integral_measure_resume`);
* for almost every sample that probability tends, as `e` grows, to `1` if the sample is in
  `G` and to `0` if it is not (`ae_tendsto_measure_resume`).
-/

@[expose] public section

namespace Transformer.Grokking.Protocol

open Filter Topology MeasureTheory ProbabilityTheory

variable {ι : Type*} {N k : ℕ}

/-- The history through an epoch keeps the history through an earlier one. -/
lemma history_comp_history {e e' : ℕ} (h : e ≤ e') :
    history (N := N) (k := k) (ι := ι) e ∘ history e' = history e := by
  funext ω
  refine Prod.ext rfl (Prod.ext rfl (funext fun n => ?_))
  by_cases hn : n < e
  · simp [history, firstShuffles, hn, lt_of_lt_of_le hn h]
  · simp [history, firstShuffles, hn]

/-- **The histories through the epochs form a filtration** of the events of a sample. -/
def historyFiltration (N k : ℕ) (ι : Type*) :
    Filtration ℕ (Prod.instMeasurableSpace : MeasurableSpace (Sample N k ι)) where
  seq e := MeasurableSpace.comap (history e) Prod.instMeasurableSpace
  mono' e e' h := by
    change MeasurableSpace.comap (history e) _ ≤ MeasurableSpace.comap (history e') _
    rw [← history_comp_history h, ← MeasurableSpace.comap_comp]
    exact MeasurableSpace.comap_mono (measurable_history e).comap_le
  le' e := (measurable_history e).comap_le

/-- A measurable function of the history through an epoch is measurable for the histories. -/
lemma measurable_comp_history {β : Type*} [MeasurableSpace β] {g : Sample N k ι → β}
    (hg : Measurable g) (e : ℕ) : Measurable[⨆ e, historyFiltration N k ι e] (g ∘ history e) :=
  (hg.comp (comap_measurable (history e))).mono
    (le_iSup (fun e => (historyFiltration N k ι e : MeasurableSpace (Sample N k ι))) e) le_rfl

/-- **Every event of a sample is generated by the histories.** -/
theorem le_iSup_historyFiltration :
    (Prod.instMeasurableSpace : MeasurableSpace (Sample N k ι)) ≤
      ⨆ e, historyFiltration N k ι e := by
  have h1 : Measurable[⨆ e, historyFiltration N k ι e] fun ω : Sample N k ι => ω.1 :=
    measurable_comp_history measurable_fst 0
  have h2 : Measurable[⨆ e, historyFiltration N k ι e] fun ω : Sample N k ι => ω.2.1 :=
    measurable_comp_history (measurable_fst.comp measurable_snd) 0
  have h3 : ∀ n, Measurable[⨆ e, historyFiltration N k ι e]
      fun ω : Sample N k ι => ω.2.2 n := fun n => by
    have hfun : (fun ω : Sample N k ι => ω.2.2 n) =
        (fun ω : Sample N k ι => ω.2.2 n) ∘ history (n + 1) := by
      funext ω
      simp [history, firstShuffles]
    rw [hfun]
    exact measurable_comp_history
      ((measurable_pi_apply n).comp (measurable_snd.comp measurable_snd)) (n + 1)
  intro s hs
  exact (h1.prodMk (h2.prodMk ((@measurable_pi_iff _ _ _
    (⨆ e, (historyFiltration N k ι e : MeasurableSpace (Sample N k ι))) _ _).2 h3))) hs

/-- Resuming a sample after epoch `e` uses its history through `e` only. -/
lemma resume_history (e : ℕ) (ω : Sample N k ι) (τ : ℕ → Equiv.Perm (Fin k)) :
    resume e (history e ω) τ = resume e ω τ := by
  refine Prod.ext rfl (Prod.ext rfl (funext fun n => ?_))
  by_cases hn : n < e <;> simp [resume, history, firstShuffles, hn]

variable (ν : Measure (ι → ℝ)) [IsProbabilityMeasure ν]

/-- **Given the history through epoch `e`, the later shuffles have their own law.** -/
theorem condDistrib_laterShuffles (e : ℕ) :
    condDistrib (fun ω : Sample N k ι => laterShuffles e ω.2.2) (history e) (law N k ν)
      =ᵐ[(law N k ν).map (history e)]
        Kernel.const _ (Measure.infinitePi fun _ : ℕ => uniformPerm k) :=
  condDistrib_ae_eq_of_measure_eq_compProd (measurable_history e).aemeasurable
    ((measurable_laterShuffles e).comp (measurable_snd.comp measurable_snd)).aemeasurable
    (by rw [Measure.compProd_const]; exact law_map_history_laterShuffles ν e)

/-- **Given the history through epoch `e`, the conditional expectation of a function of the
sample is its mean over the samples resumed with fresh shuffles.** -/
theorem condExp_history (e : ℕ) {f : Sample N k ι → ℝ} (hf : StronglyMeasurable f)
    (hint : Integrable f (law N k ν)) :
    (law N k ν)[f | historyFiltration N k ι e] =ᵐ[law N k ν]
      fun ω => ∫ τ, f (resume e ω τ) ∂Measure.infinitePi fun _ : ℕ => uniformPerm k := by
  have hX := measurable_history (N := N) (k := k) (ι := ι) e
  have hY : Measurable fun ω : Sample N k ι => laterShuffles e ω.2.2 :=
    (measurable_laterShuffles e).comp (measurable_snd.comp measurable_snd)
  have hkey := condExp_prod_ae_eq_integral_condDistrib (μ := law N k ν) hX hY.aemeasurable
    (f := fun p => f (resume e p.1 p.2)) (hf.comp_measurable (measurable_resume e))
    (by simpa only [resume_history_laterShuffles] using hint)
  simp only [resume_history_laterShuffles] at hkey
  filter_upwards [hkey, ae_of_ae_map hX.aemeasurable (condDistrib_laterShuffles ν e)]
    with ω h1 h2
  change ((law N k ν)[f | MeasurableSpace.comap (history e) Prod.instMeasurableSpace]) ω = _
  rw [h1, h2, Kernel.const_apply]
  simp only [resume_history]

variable {G : Set (Sample N k ι)}

/-- The mean of the indicator of an event over the samples resumed with fresh shuffles is the
probability that the resumed sample is in the event. -/
lemma integral_indicator_resume (hG : MeasurableSet G) (e : ℕ) (ω : Sample N k ι) :
    ∫ τ, G.indicator (fun _ => (1 : ℝ)) (resume e ω τ)
        ∂Measure.infinitePi (fun _ : ℕ => uniformPerm k) =
      (Measure.infinitePi fun _ : ℕ => uniformPerm k).real {τ | resume e ω τ ∈ G} := by
  rw [← integral_indicator_one (show MeasurableSet {τ | resume e ω τ ∈ G} from
    (measurable_resume e).comp (measurable_const.prodMk measurable_id) hG)]
  rfl

/-- **The probability of an event is the mean of the probability that the sample resumed after
epoch `e` with fresh shuffles is in it.** -/
theorem integral_measure_resume (hG : MeasurableSet G) (e : ℕ) :
    ∫ ω, (Measure.infinitePi fun _ : ℕ => uniformPerm k).real {τ | resume e ω τ ∈ G}
      ∂law N k ν = (law N k ν).real G := by
  have hf : StronglyMeasurable (G.indicator fun _ : Sample N k ι => (1 : ℝ)) :=
    stronglyMeasurable_const.indicator hG
  have hint : Integrable (G.indicator fun _ : Sample N k ι => (1 : ℝ)) (law N k ν) :=
    (integrable_const 1).indicator hG
  calc ∫ ω, (Measure.infinitePi fun _ : ℕ => uniformPerm k).real {τ | resume e ω τ ∈ G}
        ∂law N k ν
      = ∫ ω, ((law N k ν)[G.indicator fun _ => (1 : ℝ) | historyFiltration N k ι e]) ω
          ∂law N k ν := by
        refine integral_congr_ae ?_
        filter_upwards [condExp_history ν e hf hint] with ω h
        rw [h, integral_indicator_resume hG]
    _ = ∫ ω, G.indicator (fun _ => (1 : ℝ)) ω ∂law N k ν :=
        integral_condExp ((historyFiltration N k ι).le e)
    _ = (law N k ν).real G := integral_indicator_one hG

/-- **Lévy's zero-one law for the histories**: for almost every sample the probability that
the sample resumed after epoch `e` with fresh shuffles is in an event tends, as `e` grows, to
`1` if the sample is in the event and to `0` if it is not. -/
theorem ae_tendsto_measure_resume (hG : MeasurableSet G) :
    ∀ᵐ ω ∂law N k ν, Tendsto (fun e =>
        (Measure.infinitePi fun _ : ℕ => uniformPerm k).real {τ | resume e ω τ ∈ G})
      atTop (𝓝 (G.indicator (fun _ => 1) ω)) := by
  have hf : StronglyMeasurable (G.indicator fun _ : Sample N k ι => (1 : ℝ)) :=
    stronglyMeasurable_const.indicator hG
  have hint : Integrable (G.indicator fun _ : Sample N k ι => (1 : ℝ)) (law N k ν) :=
    (integrable_const 1).indicator hG
  filter_upwards [hint.tendsto_ae_condExp (ℱ := historyFiltration N k ι)
    (hf.mono le_iSup_historyFiltration), ae_all_iff.2 fun e => condExp_history ν e hf hint]
    with ω h1 h2
  refine h1.congr fun e => ?_
  rw [h2 e, integral_indicator_resume hG]

/-! The witnesses: samples of four equations of which two are trained on, under the law whose
initial parameters are zero, and the event that the first shuffle is the identity. -/

example : historyFiltration 4 2 Unit 1 ≤ historyFiltration 4 2 Unit 3 :=
  (historyFiltration 4 2 Unit).mono (by norm_num)

example := history_comp_history (N := 4) (k := 2) (ι := Unit) (by norm_num : 1 ≤ 3)

example := condDistrib_laterShuffles (N := 4) (k := 2) (Measure.dirac (0 : Unit → ℝ)) 3

example := condExp_history (N := 4) (k := 2) (Measure.dirac (0 : Unit → ℝ)) 3
  (f := fun _ => 1) stronglyMeasurable_const (integrable_const 1)

example := integral_measure_resume (N := 4) (k := 2) (Measure.dirac (0 : Unit → ℝ))
  (G := (fun ω : Sample 4 2 Unit => ω.2.2 0) ⁻¹' {1})
  (((measurable_pi_apply 0).comp (measurable_snd.comp measurable_snd))
    MeasurableSpace.measurableSet_top) 3

example := ae_tendsto_measure_resume (N := 4) (k := 2) (Measure.dirac (0 : Unit → ℝ))
  (G := (fun ω : Sample 4 2 Unit => ω.2.2 0) ⁻¹' {1})
  (((measurable_pi_apply 0).comp (measurable_snd.comp measurable_snd))
    MeasurableSpace.measurableSet_top)

end Transformer.Grokking.Protocol

+// The first triple detects regrouping at the FP32 precision boundary.
+// The last four elements detect writes past an incomplete final block.
+fn check_tied_accumulation(cuda: &kernite_cuda::Cuda) -> Result<()> {
+    let triples = [
+        (16_777_216.0_f32, 1., -16_777_216.),
+        (1., -16_777_216., 16_777_216.),
+        (-0., -0., -0.),
+        (-0.125, 1.25, -4.5),
+    ];
+    let rows: Vec<_> = triples.into_iter().cycle().take(263).collect();
+    let initial: Vec<_> = rows.iter().map(|&(x, _, _)| x).collect();
+    let g = cuda.upload(&initial)?;
+    let a = cuda.upload(&rows.iter().map(|&(_, y, _)| y).collect::<Vec<_>>())?;
+    let b = cuda.upload(&rows.iter().map(|&(_, _, z)| z).collect::<Vec<_>>())?;
+    let active = 259;
+    let kernels = crate::addresses::kernels::Kernels::load(cuda)?;
+    unsafe {
+        kernels.add_tied_gradients(
+            kernite_cuda::Grid::new(2, 256),
+            g.ptr(),
+            a.ptr(),
+            b.ptr(),
+            active,
+        )?;
+    }
+    for (i, (&value, &(x, y, z))) in g.read()?.iter().zip(&rows).enumerate() {
+        let expected = if i < active as usize { (x + y) + z } else { x };
+        if value.to_bits() != expected.to_bits() {
+            return Err(
+                "tied embedding pullback changed the FP32 order or an inactive coordinate".into(),
+            );
+        }
+    }
+    Ok(())
+}

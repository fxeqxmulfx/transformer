module

public import Transformer.Wiener.Augment

/-!
# The filtrations of the cylindrical Wiener process

*Homogenized Transformers*, arXiv:2604.01978v1, §2.4 `note:probabilistic_setting` (l. 1081):
`ℱ^W` is the usual augmentation of the noise filtration and `ℱ_t` that of the filtration
generated by the initial datum `x₀` and the noise (`Wiener/Defs.lean`). The source takes for
granted that a cylindrical Wiener process `W` for some filtration `ℱ` is one for both, when `x₀`
is independent of the noise for the second; that `ℱ^W ≤ ℱ` under the usual conditions; and that
`x₀` is independent of every `ℱ^W_t`. These are proved here from `isBrownian_augment`: an
increment of `W` after `s` is independent of `ℱ^{W,0}_s`, and of `σ(x₀) ⊔ ℱ^{W,0}_s` because `x₀`
is independent of the whole noise (`indep_sup_of_indep`); and `ℱ` already contains the null sets
and its right limits.
-/

@[expose] public section

open MeasureTheory ProbabilityTheory Filter Set
open scoped NNReal

namespace Transformer.Wiener

variable {Ω Θ E : Type*} {m : MeasurableSpace Ω} {mΘ : MeasurableSpace Θ}
  [mE : MeasurableSpace E] {P : Measure Ω} {ℱ : Filtration ℝ≥0 m} {ρ : Measure Θ}
  {W : ℝ≥0 → Lp ℝ 2 ρ → Ω → ℝ}

/-- §2.4: the noise filtration lies in every filtration for which `W` is a cylindrical Wiener
process, `W` being adapted to it. -/
theorem IsCylindricalWiener.noiseFiltration_le (hW : IsCylindricalWiener ρ ℱ P W) :
    noiseFiltration W hW.measurable ≤ ℱ := fun _ =>
  iSup₂_le fun s hs => iSup_le fun h =>
    ((hW.brownian h).adapted s).measurable.comap_le.trans (ℱ.mono hs)

/-- The noise filtration lies in `σ(W) = σ(W(t)[h] : t ≥ 0, h ∈ L²(ρ))`. -/
theorem noiseFiltration_le_iSup (hW : ∀ t h, Measurable (W t h)) (t : ℝ≥0) :
    noiseFiltration W hW t ≤ ⨆ s, ⨆ h, MeasurableSpace.comap (W s h) inferInstance :=
  iSup₂_le fun s _ => le_iSup (fun s => ⨆ h, MeasurableSpace.comap (W s h) inferInstance) s

/-- §2.4: a cylindrical Wiener process for `ℱ` is one for its noise filtration `ℱ^{W,0}`. -/
theorem isCylindricalWiener_noiseFiltration (hW : IsCylindricalWiener ρ ℱ P W) :
    IsCylindricalWiener ρ (noiseFiltration W hW.measurable) P W where
  linear := hW.linear
  brownian h :=
    { zero := (hW.brownian h).zero
      continuous := (hW.brownian h).continuous
      adapted t := (comap_measurable (W t h)).stronglyMeasurable.mono
        (le_iSup₂_of_le (f := fun s (_ : s ≤ t) => ⨆ g, MeasurableSpace.comap (W s g) inferInstance)
          t le_rfl (le_iSup (fun g => MeasurableSpace.comap (W t g) inferInstance) h))
      indep s t hst := indep_of_indep_of_le_right ((hW.brownian h).indep s t hst)
        (hW.noiseFiltration_le s)
      hasLaw := (hW.brownian h).hasLaw }

/-- §2.4: a cylindrical Wiener process for some filtration is one for `ℱ^W`, the usual
augmentation of its noise filtration. -/
theorem isCylindricalWiener_wienerFiltration [P.IsComplete] (hW : IsCylindricalWiener ρ ℱ P W) :
    IsCylindricalWiener ρ (wienerFiltration P W hW.measurable) P W :=
  ⟨hW.linear, fun h => isBrownian_augment ((isCylindricalWiener_noiseFiltration hW).brownian h)⟩

/-- If `m₀` is independent of `m'`, and `m₁, m₂ ≤ m'` are independent, then `m₁` is independent
of `m₀ ⊔ m₂`: the sets `a ∩ c`, `a ∈ m₀`, `c ∈ m₂`, form a π-system generating `m₀ ⊔ m₂`. -/
theorem indep_sup_of_indep [IsProbabilityMeasure P] {m₀ m₁ m₂ m' : MeasurableSpace Ω}
    (h₀ : m₀ ≤ m) (h₁ : m₁ ≤ m') (h₂ : m₂ ≤ m') (h' : m' ≤ m) (h0 : Indep m₀ m' P)
    (h12 : Indep m₁ m₂ P) : Indep m₁ (m₀ ⊔ m₂) P := by
  let p : Set (Set Ω) := {u | ∃ a c, MeasurableSet[m₀] a ∧ MeasurableSet[m₂] c ∧ u = a ∩ c}
  have hp : IsPiSystem p := by
    rintro _ ⟨a, c, ha, hc, rfl⟩ _ ⟨a', c', ha', hc', rfl⟩ -
    exact ⟨a ∩ a', c ∩ c', ha.inter ha', hc.inter hc', Set.inter_inter_inter_comm a c a' c'⟩
  have hgen : m₀ ⊔ m₂ = MeasurableSpace.generateFrom p := by
    refine le_antisymm (sup_le (fun a ha => ?_) fun c hc => ?_) (MeasurableSpace.generateFrom_le ?_)
    · exact MeasurableSpace.measurableSet_generateFrom ⟨a, univ, ha, .univ, (inter_univ a).symm⟩
    · exact MeasurableSpace.measurableSet_generateFrom ⟨univ, c, .univ, hc, (univ_inter c).symm⟩
    · rintro _ ⟨a, c, ha, hc, rfl⟩
      exact (le_sup_left (b := m₂) a ha).inter (le_sup_right (a := m₀) c hc)
  refine IndepSets.indep (h₁.trans h') (sup_le h₀ (h₂.trans h'))
    (@MeasurableSpace.isPiSystem_measurableSet Ω m₁) hp
    (@MeasurableSpace.generateFrom_measurableSet Ω m₁).symm hgen ?_
  rw [IndepSets_iff]
  rintro s _ hs ⟨a, c, ha, hc, rfl⟩
  have hsc : P (a ∩ (s ∩ c)) = P a * P (s ∩ c) :=
    (Indep_iff _ _ P).1 h0 a _ ha ((h₁ s hs).inter (h₂ c hc))
  rw [show s ∩ (a ∩ c) = a ∩ (s ∩ c) by rw [inter_left_comm], hsc,
    (Indep_iff _ _ P).1 h12 s c hs hc, (Indep_iff _ _ P).1 h0 a c ha (h₂ c hc)]
  ring

/-- §2.4: with an initial datum `x₀` independent of the noise, a cylindrical Wiener process for
some filtration is one for the filtration `ℱ_t` generated by `x₀` and the noise. -/
theorem isCylindricalWiener_wienerFiltrationWith [P.IsComplete]
    (hW : IsCylindricalWiener ρ ℱ P W) {x₀ : Ω → E} (hx₀ : Measurable x₀)
    (hind : IndepOfWiener x₀ W P) :
    IsCylindricalWiener ρ (wienerFiltrationWith P x₀ hx₀ W hW.measurable) P W := by
  refine ⟨hW.linear, fun h => isBrownian_augment ?_⟩
  have hn := (isCylindricalWiener_noiseFiltration hW).brownian h
  have := hn.isProbabilityMeasure
  have hσ : ∀ t g, Measurable[⨆ s, ⨆ h, MeasurableSpace.comap (W s h) inferInstance] (W t g) :=
    fun t g => (comap_measurable (W t g)).mono
      (le_iSup₂ (f := fun s h => MeasurableSpace.comap (W s h) inferInstance) t g) le_rfl
  exact
    { zero := hn.zero
      continuous := hn.continuous
      adapted t := (hn.adapted t).mono le_sup_right
      indep s t hst := indep_sup_of_indep hx₀.comap_le ((hσ t h).sub (hσ s h)).comap_le
        (noiseFiltration_le_iSup hW.measurable s)
        (iSup₂_le fun t g => (hW.measurable t g).comap_le) hind (hn.indep s t hst)
      hasLaw := hn.hasLaw }

/-- §2.4: under the usual conditions, `ℱ^W ≤ ℱ` for a cylindrical Wiener process `W` for `ℱ`. -/
theorem wienerFiltration_le [P.IsComplete] (hU : UsualConditions ℱ P)
    (hW : IsCylindricalWiener ρ ℱ P W) : wienerFiltration P W hW.measurable ≤ ℱ := by
  intro t
  have hle : wienerFiltration P W hW.measurable t ≤ ℱ.rightCont t := by
    rw [wienerFiltration, augment, Filtration.rightCont_eq, Filtration.rightCont_eq]
    exact iInf₂_mono fun u _ => sup_le (hW.noiseFiltration_le u)
      (MeasurableSpace.generateFrom_le fun s hs => ℱ.mono zero_le s (hU.measurableSet_of_null s hs))
  exact hle.trans (hU.isRightContinuous.RC t)

/-- §2.4: an initial datum independent of the noise is independent of every `ℱ^W_t`. -/
theorem IndepOfWiener.indep_wienerFiltration [P.IsComplete] {x₀ : Ω → E}
    (hind : IndepOfWiener x₀ W P) (hW : ∀ t h, Measurable (W t h)) (t : ℝ≥0) :
    Indep (MeasurableSpace.comap x₀ mE) (wienerFiltration P W hW t) P :=
  indep_of_indep_of_le_right (indep_sup_nullSigma hind) ((augment_le_of_lt _ (lt_add_one t)).trans
    (sup_le_sup_right (noiseFiltration_le_iSup hW (t + 1)) _))

/-- The hypotheses hold for the zero noise on `L²(0)` and the zero initial datum under the Dirac
mass on `Unit`, a complete probability space, with the constant filtration. -/
example :
    haveI : (Measure.dirac ()).IsComplete := ⟨fun _ _ => Subsingleton.measurableSet⟩
    let ℱ := Filtration.const ℝ≥0 (inferInstance : MeasurableSpace Unit) le_rfl
    let W : ℝ≥0 → Lp ℝ 2 (0 : Measure ℝ) → Unit → ℝ := fun _ _ _ => 0
    let hW : ∀ t h, Measurable (W t h) := fun _ _ => measurable_const
    noiseFiltration W hW ≤ ℱ ∧
      noiseFiltration W hW 0 ≤ ⨆ s, ⨆ h, MeasurableSpace.comap (W s h) inferInstance ∧
      IsCylindricalWiener 0 (noiseFiltration W hW) (Measure.dirac ()) W ∧
      IsCylindricalWiener 0 (wienerFiltration (Measure.dirac ()) W hW) (Measure.dirac ()) W ∧
      Indep (⊥ : MeasurableSpace Unit) (⊥ ⊔ ⊥) (Measure.dirac ()) ∧
      IsCylindricalWiener 0 (wienerFiltrationWith (Measure.dirac ()) (fun _ => (0 : ℝ))
        measurable_const W hW) (Measure.dirac ()) W ∧
      wienerFiltration (Measure.dirac ()) W hW ≤ ℱ ∧
      Indep (MeasurableSpace.comap (fun _ => (0 : ℝ)) inferInstance)
        (wienerFiltration (Measure.dirac ()) W hW 1) (Measure.dirac ()) := by
  intro ℱ W hW
  have : (Measure.dirac ()).IsComplete := ⟨fun _ _ => Subsingleton.measurableSet⟩
  have hW' : IsCylindricalWiener 0 ℱ (Measure.dirac ()) W := isCylindricalWiener_zero ℱ
  have hind : IndepOfWiener (fun _ => (0 : ℝ)) W (Measure.dirac ()) := by
    rw [IndepOfWiener, MeasurableSpace.comap_const]
    exact indep_bot_left _
  exact ⟨hW'.noiseFiltration_le, noiseFiltration_le_iSup hW 0,
    isCylindricalWiener_noiseFiltration hW', isCylindricalWiener_wienerFiltration hW',
    indep_sup_of_indep bot_le le_rfl le_rfl bot_le (indep_bot_left _) (indep_bot_left _),
    isCylindricalWiener_wienerFiltrationWith hW' measurable_const hind,
    wienerFiltration_le usualConditions_const hW', hind.indep_wienerFiltration hW 1⟩

end Transformer.Wiener
